---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CouponCard from '../../components/CouponCard.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { PRODUCTS } from '../../data/products';
import { DEALS } from '../../data/deals';

const hostingProducts = PRODUCTS.filter(p => p.category === 'hosting');
const hostingDeals = DEALS.filter(d => d.category === 'Hosting');

const hostingFaqs = [
  {
    question: "Why do you recommend LiteSpeed servers over standard Apache?",
    answer: "In our independent WordPress TTFB (Time to First Byte) benchmark, LiteSpeed Web Server coupled with the LSCache plugin delivered up to 300% faster response times and handled 5x higher concurrent traffic spikes without slowing down."
  },
  {
    question: "Is the free domain included permanently?",
    answer: "Most web hosting providers (including Hostinger and Bluehost) include a free .com or .in domain registration for the first 12 months. Subsequent annual renewals are billed at standard registrar rates."
  }
];
---

<BaseLayout
  title="Best Web Hosting & Domain Discounts 2026 | Uptime & TTFB Benchmarks"
  description="Compare the fastest WordPress web hosting providers, cloud VPS, and domain registrars. Exclusive 75% promo codes, free SSL, and uptime test scores."
>
  <div class="container">
    <Breadcrumbs crumbs={[{ label: "Web Hosting & Domains" }]} />

    <div class="category-header-wrap">
      <span class="badge badge-deal">⚡ SERVER PERFORMANCE RADAR</span>
      <h1 class="cat-title">Tested Web Hosting & Cloud Server Benchmarks</h1>
      <p class="cat-subtitle">
        We monitor server response times (TTFB), 99.99% uptime consistency, and customer support responsiveness 365 days a year across leading global web hosts.
      </p>
    </div>

    <!-- Exclusive Promo Codes Highlight -->
    {hostingDeals.length > 0 && (
      <div style="margin: 32px 0;">
        <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 16px;">Verified Hosting Coupon Codes</h3>
        <div class="grid-2">
          {hostingDeals.map((deal) => (
            <CouponCard deal={deal} />
          ))}
        </div>
      </div>
    )}

    <!-- Product Showcase -->
    <div class="section-header" style="margin-top: 32px;">
      <div>
        <h2 class="section-title">Editor's Recommended Hosting Plans</h2>
        <p class="section-subtitle">Ranked by price-to-performance ratio, NVMe speed, and reliability.</p>
      </div>
    </div>

    <div class="grid-2">
      {hostingProducts.map((prod) => (
        <ProductCard product={prod} />
      ))}
    </div>

    <!-- Hosting Benchmark Table -->
    <div class="benchmark-box card">
      <h3>2026 Web Host Lab Benchmark Scores</h3>
      <div class="table-responsive">
        <table class="benchmark-table">
          <thead>
            <tr>
              <th>Hosting Provider</th>
              <th>Average TTFB</th>
              <th>30-Day Uptime</th>
              <th>Free Domain</th>
              <th>Discount Link</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Hostinger Cloud</strong></td>
              <td><span class="score-fast">184 ms</span></td>
              <td>99.99%</td>
              <td>Yes (1 Year Free)</td>
              <td><a href="/go/hostinger?deal=cloud-startup-75off" target="_blank" rel="sponsored nofollow noopener" class="btn btn-affiliate btn-sm">Claim 75% Off</a></td>
            </tr>
            <tr>
              <td><strong>SiteGround GrowBig</strong></td>
              <td><span class="score-fast">210 ms</span></td>
              <td>99.98%</td>
              <td>No</td>
              <td><a href="/go/siteground" target="_blank" rel="sponsored nofollow noopener" class="btn btn-secondary btn-sm">View Deal</a></td>
            </tr>
            <tr>
              <td><strong>Cloudways DigitalOcean</strong></td>
              <td><span class="score-fast">162 ms</span></td>
              <td>99.99%</td>
              <td>No</td>
              <td><a href="/go/cloudways" target="_blank" rel="sponsored nofollow noopener" class="btn btn-secondary btn-sm">View Deal</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <FAQAccordion faqs={hostingFaqs} title="Web Hosting & Migration FAQs" />
  </div>
</BaseLayout>

<style>
  .category-header-wrap {
    padding: 32px 0 24px;
    border-bottom: 1px solid var(--border-default);
  }

  .cat-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    margin: 12px 0 10px;
    letter-spacing: -0.02em;
  }

  .cat-subtitle {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 780px;
  }

  .benchmark-box {
    padding: 28px;
    margin: 40px 0;
  }

  .benchmark-box h3 {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 18px;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .benchmark-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .benchmark-table th,
  .benchmark-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-default);
    font-size: 0.9rem;
  }

  .benchmark-table th {
    background: #f8fafc;
    font-weight: 700;
  }

  .score-fast {
    color: #16a34a;
    font-weight: 700;
  }
</style>
