<script is:inline>
(function () {
  const list = document.getElementById('provider-list');
  if (!list) return;
  const EASE_MS = 800;
  let openCard = null, placeholder = null, backdrop = null, closeBtn = null, origin = null;

  list.querySelectorAll('li.pcard').forEach(c => {
    c.setAttribute('tabindex', '0');
    c.setAttribute('role', 'button');
    c.setAttribute('aria-expanded', 'false');
  });

  function targetBox(card) {
    const vw = window.innerWidth, vh = window.innerHeight;
    const w = Math.min(640, vw - 28);
    const prev = { w: card.style.width, h: card.style.height };
    card.style.width = w + 'px';
    card.style.height = 'auto';
    const natural = card.scrollHeight;
    card.style.width = prev.w;
    card.style.height = prev.h;
    const h = Math.min(natural, vh - 40);
    return { w, h, left: (vw - w) / 2, top: Math.max(20, (vh - h) / 2) };
  }

  function open(card) {
    if (openCard) return;
    openCard = card;
    const r = card.getBoundingClientRect();
    const cs = getComputedStyle(card);
    placeholder = document.createElement('li');
    placeholder.className = 'pcard-ph';
    placeholder.style.height = r.height + 'px';
    placeholder.style.marginTop = cs.marginTop;
    card.before(placeholder);

    backdrop = document.createElement('div');
    backdrop.className = 'pcard-backdrop';
    backdrop.addEventListener('click', close);
    document.body.appendChild(backdrop);

    closeBtn = document.createElement('button');
    closeBtn.type = 'button';
    closeBtn.className = 'pcard-close';
    closeBtn.setAttribute('aria-label', 'Close');
    closeBtn.innerHTML = '&times;';
    closeBtn.addEventListener('click', e => { e.stopPropagation(); close(); });

    card.style.top = r.top + 'px';
    card.style.left = r.left + 'px';
    card.style.width = r.width + 'px';
    card.style.height = r.height + 'px';
    card.classList.add('is-zoom');
    card.appendChild(closeBtn);
    card.setAttribute('aria-expanded', 'true');
    document.body.classList.add('stack-lock');
    origin = r;

    const t = targetBox(card);
    void card.offsetWidth;                       // commit start rect before animating
    backdrop.classList.add('show');
    card.style.top = t.top + 'px';
    card.style.left = t.left + 'px';
    card.style.width = t.w + 'px';
    card.style.height = t.h + 'px';
    closeBtn.focus({ preventScroll: true });
    setTimeout(() => { if (openCard === card) card.classList.add('settled'); }, EASE_MS);
  }

  function close() {
    if (!openCard) return;
    const card = openCard, ph = placeholder, bd = backdrop;
    const r = ph.getBoundingClientRect();
    bd.classList.remove('show');
    card.style.top = r.top + 'px';
    card.style.left = r.left + 'px';
    card.style.width = r.width + 'px';
    card.style.height = r.height + 'px';
    card.classList.remove('settled');
    openCard = null;
    setTimeout(() => {
      card.classList.remove('is-zoom');
      card.style.top = card.style.left = card.style.width = card.style.height = '';
      card.setAttribute('aria-expanded', 'false');
      if (closeBtn) closeBtn.remove();
      ph.remove(); bd.remove();
      document.body.classList.remove('stack-lock');
      card.focus({ preventScroll: true });
    }, EASE_MS);
  }

  list.addEventListener('click', e => {
    const card = e.target.closest('li.pcard');
    if (!card) return;
    if (card.classList.contains('is-zoom')) return;   // links inside the open card work normally
    e.preventDefault();
    open(card);
  }, true);

  list.addEventListener('keydown', e => {
    const card = e.target.closest && e.target.closest('li.pcard');
    if (card && e.target === card && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(card); }
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
  window.addEventListener('resize', () => {
    if (!openCard) return;
    const t = targetBox(openCard);
    Object.assign(openCard.style, { top: t.top + 'px', left: t.left + 'px', width: t.w + 'px', height: t.h + 'px' });
  });
})();
</script>

<script type="application/json" id="cat-index" set:html={JSON.stringify(searchIndex)}></script>
<script is:inline>
(function () {
  const input = document.getElementById('site-search-input');
  const list = document.getElementById('site-search-results');
  const clearBtn = document.getElementById('site-search-clear');
  const raw = document.getElementById('cat-index');
  if (!input || !list || !raw) return;
  let cats = [];
  try { cats = JSON.parse(raw.textContent); } catch (e) { return; }
  let active = -1, shown = [];

  const img = (e) => 'https://cdn.jsdelivr.net/npm/@lobehub/fluent-emoji-3d@1.1.0/assets/' +
    Array.from(e).map(c => c.codePointAt(0).toString(16).padStart(4, '0')).join('-') + '.webp';
  const esc = (t) => String(t).replace(/[&<>"]/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));

  function search(q) {
    const t = q.toLowerCase().trim();
    if (!t) return [];
    const hits = [];
    cats.forEach(c => {
      const n = c.name.toLowerCase(), g = c.gu.toLowerCase();
      let rank = -1;
      if (n.startsWith(t)) rank = 0;
      else if (n.split(/[\s/(),&-]+/).some(w => w.startsWith(t))) rank = 1;
      else if (n.includes(t) || g.includes(t)) rank = 2;
      if (rank >= 0) hits.push({ c, rank });
    });
    return hits.sort((a, b) => a.rank - b.rank || a.c.name.localeCompare(b.c.name)).slice(0, 8).map(h => h.c);
  }

  function render() {
    const q = input.value;
    shown = search(q);
    active = shown.length ? 0 : -1;
    if (clearBtn) clearBtn.hidden = !q;
    if (!q.trim()) { close(); return; }
    list.innerHTML = shown.length
      ? shown.map((c, i) => '<li role="option" id="cs-opt-' + i + '"' + (i === active ? ' class="on" aria-selected="true"' : '') + '>' +
          '<a href="/bhuj/' + c.id + '-in-bhuj.html"><img src="' + img(c.icon) + '" alt="" width="28" height="28" loading="lazy">' +
          '<span class="cs-name">' + esc(c.name) + '</span>' + (c.gu ? '<span class="cs-gu">' + esc(c.gu) + '</span>' : '') + '</a></li>').join('')
      : '<li class="cs-none">No service found for “' + esc(q.trim()) + '”</li>';
    list.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  }
  function close() { list.hidden = true; input.setAttribute('aria-expanded', 'false'); }
  function mark(i) {
    const items = list.querySelectorAll('li[role="option"]');
    if (!items.length) return;
    active = (i + items.length) % items.length;
    items.forEach((el, k) => { el.classList.toggle('on', k === active); el.toggleAttribute('aria-selected', k === active); });
    items[active].scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('input', render);
  input.addEventListener('focus', () => { if (input.value.trim()) render(); });
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); mark(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); mark(active - 1); }
    else if (e.key === 'Escape') { close(); }
    else if (e.key === 'Enter' && shown[active]) { window.location.href = '/bhuj/' + shown[active].id + '-in-bhuj.html'; }
  });
  if (clearBtn) clearBtn.addEventListener('click', () => { input.value = ''; render(); input.focus(); });
  document.addEventListener('click', e => { if (!e.target.closest('#site-search')) close(); });
})();
</script>
