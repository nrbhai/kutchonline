---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { BLOG_POSTS, type BlogPost } from '../../data/blog';
import { PRODUCTS } from '../../data/products';

export async function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Associated affiliate product picks
const featuredProducts = PRODUCTS.filter(p => post.affiliateProducts.includes(p.slug));

// Article Schema.org
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.excerpt,
  "image": [post.image],
  "datePublished": "2026-10-10T08:00:00+08:00",
  "dateModified": "2026-10-12T12:00:00+08:00",
  "author": {
    "@type": "Person",
    "name": post.author.name,
    "jobTitle": post.author.role
  },
  "publisher": {
    "@type": "Organization",
    "name": "BhujDeals",
    "logo": {
      "@type": "ImageObject",
      "url": "https://bhujdeals.com/logo.png"
    }
  }
};
---

<BaseLayout
  title={`${post.title} | BhujDeals Buying Guide`}
  description={post.excerpt}
  image={post.image}
  type="article"
  schemaJson={articleSchema}
>
  <div class="container">
    <Breadcrumbs crumbs={[
      { label: "Guides & Reviews", href: "/blog" },
      { label: post.category },
      { label: post.title }
    ]} />

    <div class="article-layout">
      <!-- Main Content Column -->
      <article class="article-main">
        <div class="article-header">
          <span class="badge badge-brand">{post.category}</span>
          <h1 class="article-title">{post.title}</h1>

          <div class="article-byline">
            <img src={post.author.avatar} alt={post.author.name} class="byline-avatar" />
            <div class="byline-info">
              <span class="byline-name">By {post.author.name}</span>
              <span class="byline-date">{post.author.role} • Published {post.publishedAt} • {post.readTime}</span>
            </div>
          </div>
        </div>

        <div class="article-hero-media card">
          <img src={post.image} alt={post.title} class="article-hero-img" />
        </div>

        <!-- Editorial Disclosure Notice -->
        <div class="article-disclosure-box">
          <span class="disc-icon">⚖️</span>
          <p>
            <strong>Editorial Independence:</strong> Products reviewed are evaluated without commercial influence. When you make a purchase through links in this guide, we may earn an affiliate commission. <a href="/affiliate-disclosure">Read our testing pledge.</a>
          </p>
        </div>

        <!-- Render Content -->
        <div class="article-prose" set:html={post.contentHtml} />

        <!-- Featured Product Widgets -->
        {featuredProducts.length > 0 && (
          <div class="featured-picks-section">
            <h3 class="picks-title">Featured Products Mentioned in This Guide</h3>
            <div class="grid-2">
              {featuredProducts.map(prod => (
                <ProductCard product={prod} />
              ))}
            </div>
          </div>
        )}
      </article>

      <!-- Sidebar: Table of Contents & Sticky Deal -->
      <aside class="article-sidebar">
        <div class="toc-card card">
          <h4 class="toc-title">Table of Contents</h4>
          <ol class="toc-list">
            {post.tableOfContents.map((item, idx) => (
              <li>
                <span class="toc-idx">0{idx + 1}.</span> {item}
              </li>
            ))}
          </ol>
        </div>

        <div class="sidebar-help card">
          <h4>Have a Product Question?</h4>
          <p>Our lab testing team responds to reader inquiries within 24 hours.</p>
          <a href="/contact" class="btn btn-secondary btn-sm" style="width: 100%;">Ask an Editor</a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    margin: 24px 0 56px;
    align-items: start;
  }

  .article-header {
    margin-bottom: 24px;
  }

  .article-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 14px 0 16px;
    letter-spacing: -0.02em;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .byline-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }

  .byline-name {
    display: block;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .byline-date {
    display: block;
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .article-hero-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: 24px;
  }

  .article-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-disclosure-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #f8fafc;
    border: 1px solid var(--border-default);
    border-left: 4px solid var(--color-primary);
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin-bottom: 32px;
  }

  .disc-icon {
    font-size: 1.25rem;
  }

  .article-disclosure-box a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .article-prose {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-body);
  }

  .article-prose :global(h2) {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 36px 0 16px;
    color: var(--text-main);
  }

  .article-prose :global(p) {
    margin-bottom: 20px;
  }

  .article-prose :global(.lead) {
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.7;
    color: var(--text-main);
  }

  .featured-picks-section {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 2px solid var(--border-default);
  }

  .picks-title {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 24px;
  }

  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 90px;
  }

  .toc-card {
    padding: 24px;
    background: #ffffff;
  }

  .toc-title {
    font-size: 1rem;
    font-weight: 800;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-main);
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .toc-idx {
    font-weight: 700;
    color: var(--color-primary);
  }

  .sidebar-help {
    padding: 24px;
    background: #f8fafc;
  }

  .sidebar-help h4 {
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .sidebar-help p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  @media (max-width: 960px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
