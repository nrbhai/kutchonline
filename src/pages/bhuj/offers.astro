---
import BhujLayout from "../../layouts/BhujLayout.astro";
---

<BhujLayout
  title="Premium Advertising & Business Verification Offers | bhuj.kutchonline.com"
  description="Get your business Verified or Top Rated on bhuj.kutchonline.com. Increase trust, stand out in local search results, and attract more customers in Bhuj, Kutch."
  canonicalPath="offers"
  bodyClass="page-offers"
>
  <style is:inline>
      .page-offers main {
          background-color: #f8fafc !important;
          color: #334155 !important;
      }
      .hero-offers {
          padding: 60px 0;
          background: radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent), radial-gradient(circle at bottom right, rgba(37, 99, 235, 0.03), transparent) !important;
      }
      .hero-text h1 {
          color: #0f172a !important;
      }
      .hero-text p {
          color: #475569 !important;
      }
      .hero-text strong {
          color: #2563eb !important;
      }
      .btn-primary-blue {
          background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
          color: #ffffff !important;
          padding: 12px 28px;
          border-radius: 999px;
          font-weight: 700;
          text-decoration: none;
          display: inline-block;
          box-shadow: 0 4px 15px rgba(37, 99, 235, 0.2) !important;
          transition: all 0.2s ease !important;
      }
      .btn-primary-blue:hover {
          background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%) !important;
          transform: translateY(-2px);
          box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3) !important;
      }
      .btn-outline-blue {
          background: transparent !important;
          color: #2563eb !important;
          border: 1px solid #cbd5e1 !important;
          padding: 12px 28px;
          border-radius: 999px;
          font-weight: 700;
          text-decoration: none;
          display: inline-block;
          transition: all 0.2s ease !important;
      }
      .btn-outline-blue:hover {
          background: rgba(37, 99, 235, 0.05) !important;
          border-color: #2563eb !important;
          transform: translateY(-2px);
      }
      .section-pricing {
          background-color: #f1f5f9 !important;
          padding: 80px 0;
          border-top: 1px solid #e2e8f0;
          border-bottom: 1px solid #e2e8f0;
      }
      .price-card-blue {
          background: #ffffff !important;
          border: 1px solid #e2e8f0 !important;
          border-radius: 24px;
          padding: 35px;
          text-align: center;
          box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04) !important;
          transition: all 0.3s ease !important;
      }
      .price-card-blue:hover {
          transform: translateY(-5px);
          border-color: #2563eb !important;
          box-shadow: 0 12px 30px rgba(37, 99, 235, 0.1) !important;
      }
      .price-card-blue.popular {
          border-top: 5px solid #2563eb !important;
          box-shadow: 0 10px 30px rgba(37, 99, 235, 0.05) !important;
      }
      .price-card-blue.popular:hover {
          box-shadow: 0 15px 35px rgba(37, 99, 235, 0.15) !important;
      }
      .price-card-blue h3 {
          color: #0f172a !important;
      }
      .price-card-blue .price {
          color: #2563eb !important;
      }
      .price-card-blue .price span {
          color: #64748b !important;
      }
      .section-how {
          background-color: #ffffff !important;
          padding: 80px 0;
          border-bottom: 1px solid #e2e8f0;
      }
      .section-how h2 {
          color: #0f172a !important;
      }
      .section-how h5 {
          color: #334155 !important;
      }
      .step-number {
          width: 44px;
          height: 44px;
          background: #f8fafc !important;
          border: 2px solid #2563eb !important;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          margin: 0 auto 15px;
          font-weight: 800;
          color: #2563eb !important;
      }
      .section-testimonials {
          background-color: #f8fafc !important;
          padding: 80px 0;
      }
      .section-testimonials h2 {
          color: #0f172a !important;
      }
      .testimonial-card {
          background: #ffffff !important;
          border: 1px solid #e2e8f0 !important;
          border-radius: 24px;
          padding: 35px;
          text-align: center;
          box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04) !important;
      }
      .testimonial-text {
          color: #475569 !important;
      }
      .testimonial-author {
          color: #2563eb !important;
          font-weight: 700;
      }
  </style>

  <main style="padding-top: 20px;">
      <section class="hero-offers">
          <div class="container hero-inner" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); align-items: center; gap: 40px;">
              <div class="hero-text">
                  <h1 style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.3; margin-bottom: 15px; font-weight: 800; letter-spacing: -0.03em; font-family: var(--font-tech);">તમારા બિઝનેસમાં વધુ Customers મેળવો 🚀</h1>
                  <p style="font-size: 1.1rem; margin-bottom: 30px; font-family: var(--font-main);">bhuj.kutchonline.com પર <strong>Verified</strong> અને <strong>Top Rated</strong> બેજ મેળવીને તમારા બિઝનેસ પર Customers નો ભરોસો વધારો.</p>
                  <div class="hero-btns" style="display: flex; gap: 15px; flex-wrap: wrap;">
                      <a href="#pricing" class="btn btn-primary-blue">View Plans</a>
                      <a href="https://wa.me/919825034580" class="btn btn-outline-blue">WhatsApp Now</a>
                  </div>
              </div>
              <div class="hero-image-wrap" style="text-align: center;">
                  <img src="/assets/public/images/offers/offers-growth-main.png" alt="Business Growth" class="hero-image" style="width: 100%; max-width: 400px; height: auto; filter: drop-shadow(0 20px 40px rgba(37, 99, 235, 0.08));">
              </div>
          </div>
      </section>

      <!-- PRICING SECTION -->
      <section id="pricing" class="section-pricing">
          <div class="container">
              <div class="pricing-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; max-width: 800px; margin: 0 auto;">
                  <div class="price-card-blue">
                      <img src="/assets/public/images/offers/offer_verified_badge.png" alt="Verified Badge" class="plan-icon" style="width: 80px; height: 80px; margin-bottom: 20px;">
                      <h3 style="font-weight: 700; font-size: 1.6rem; margin-bottom: 10px;">Verified Business</h3>
                      <div class="price" style="font-size: 2.8rem; font-weight: 800;">₹699<span style="font-size: 1rem;">/year</span></div>
                      <a href="https://wa.me/919825034580" class="btn btn-outline-blue" style="width: 100%; margin-top: 20px; justify-content: center; display: inline-block; text-align: center;">Get Verified</a>
                  </div>

                  <div class="price-card-blue popular">
                      <img src="/assets/public/images/offers/offer_top_rated_star.png" alt="Top Rated Star" class="plan-icon" style="width: 80px; height: 80px; margin-bottom: 20px;">
                      <h3 style="font-weight: 700; font-size: 1.6rem; margin-bottom: 10px;">Top Rated Business</h3>
                      <div class="price" style="font-size: 2.8rem; font-weight: 800;">₹1299<span style="font-size: 1rem;">/year</span></div>
                      <a href="https://wa.me/919825034580" class="btn btn-primary-blue" style="width: 100%; margin-top: 20px; justify-content: center; display: inline-block; text-align: center;">Go Top Rated</a>
                  </div>
              </div>
          </div>
      </section>

      <!-- HOW IT WORKS -->
      <section class="section-how">
          <div class="container" style="text-align: center;">
              <h2 style="font-weight: 700; font-size: 2.1rem; margin-bottom: 50px;">આ કેવી રીતે કામ કરે છે?</h2>
              <div class="steps-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 30px;">
                  <div>
                      <div class="step-number">1</div>
                      <h3 style="font-weight: 700; font-size: 1.1rem; margin: 0;">Details Submit કરો</h3>
                  </div>
                  <div>
                      <div class="step-number">2</div>
                      <h3 style="font-weight: 700; font-size: 1.1rem; margin: 0;">Verification</h3>
                  </div>
                  <div>
                      <div class="step-number">3</div>
                      <h3 style="font-weight: 700; font-size: 1.1rem; margin: 0;">Badge મેળવો</h3>
                  </div>
              </div>
          </div>
      </section>

      <!-- TESTIMONIALS -->
      <section class="section-testimonials">
          <div class="container" style="text-align: center;">
              <h2 style="font-weight: 700; font-size: 2.1rem; margin-bottom: 50px;">અમારા વેરિફાઇડ બિઝનેસ શું કહે છે?</h2>
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; max-width: 800px; margin: 0 auto;">
                  <div class="testimonial-card">
                      <p class="testimonial-text" style="font-style: italic; margin-bottom: 15px;">"Top Rated Badge મળ્યા પછી ઇન્કવાયરી કોલ્સમાં ઘણો વધારો થયો છે."</p>
                      <div class="testimonial-author">Hitesh Soni (Insurance Business)</div>
                  </div>
                  <div class="testimonial-card">
                      <p class="testimonial-text" style="font-style: italic; margin-bottom: 15px;">"bhuj.kutchonline.com સાથે જોડાવું એ મારા બિઝનેસ માટે બેસ્ટ નિર્ણય હતો."</p>
                      <div class="testimonial-author">Pradip Shah (Real Estate)</div>
                  </div>
              </div>
          </div>
      </section>
  </main>
</BhujLayout>
