---
import BhujLayout from "../../layouts/BhujLayout.astro";

const WA = "https://wa.me/919825034580";
const wa = (msg: string) => `${WA}?text=${encodeURIComponent(msg)}`;

// 3D emoji (Microsoft Fluent Emoji 3D): filename = unicode codepoints joined by "-"
const em = (e: string) =>
  `https://cdn.jsdelivr.net/npm/@lobehub/fluent-emoji-3d@1.1.0/assets/${Array.from(e).map(c => c.codePointAt(0)!.toString(16).padStart(4, "0")).join("-")}.webp`;

const plans = [
  {
    emoji: "✅",
    tag: "Start here",
    name: "Get Verified",
    price: "899",
    line: "The badge that says “this business is real”.",
    points: ["Verified badge on your listing", "Shown ahead of unverified listings", "Phone number confirmed by our team"],
    cta: "Get Verified",
    msg: "Hi! I want the Verified badge for my business (₹899 + GST).",
  },
  {
    emoji: "🏆",
    tag: "Most popular",
    name: "Top Rated + Webpage",
    price: "1999",
    line: "Stand out — and get a page of your own.",
    points: ["Top Rated badge on your listing", "Your own webpage: products, services & photos", "Shown ahead of unverified listings"],
    cta: "Get Top Rated + Webpage",
    msg: "Hi! I want the Top Rated badge and webpage for my business (₹1999 + GST).",
    hot: true,
  },
  {
    emoji: "🌐",
    tag: "Full website",
    name: "Business Website",
    price: "6,999",
    unit: "one-time website design",
    line: "A complete multi-page website for your business — 5 to 8 pages.",
    extras: ["+ ₹2,000 SEO for Google & Search Engines", "+ ₹2,000 optional CMS — update notices, photos & other content yourself"],
    points: [
      "5 to 8 professionally designed pages",
      "Custom domain setup",
      "WhatsApp & Tap-to-Call links",
      "Google Maps integration",
      "Mobile & tablet responsive",
      "Contact form included",
      "Photo gallery / services showcase",
    ],
    cta: "Get My Website",
    msg: "Hi! I want a Business Website (5 to 8 pages) for my business (₹6,999 one-time).",
  },
];

const perks = [
  { emoji: "🤝", title: "Trust at a glance", text: "A badge tells a stranger you’re genuine before they even call." },
  { emoji: "🔝", title: "Higher in the list", text: "Verified and Top Rated businesses are shown first in their category." },
  { emoji: "🌐", title: "A page that’s yours", text: "Show products, services and photos on your own webpage." },
  { emoji: "💬", title: "Straight to WhatsApp", text: "No forms, no waiting rooms — just message us and we start." },
];

const steps = [
  { emoji: "📲", title: "Message us", text: "Send your business name and category on WhatsApp." },
  { emoji: "📞", title: "We verify", text: "Our team confirms your details with a quick call." },
  { emoji: "🚀", title: "You go live", text: "Your badge (and page) appears on bhuj.kutchonline.com." },
];

const faqs = [
  { q: "Is the price per year?", a: "Verified is ₹899 + GST per year and Top Rated + Webpage is ₹1999 + GST per year. The Business Website is ₹6,999 one-time for design, with optional extras: SEO for ₹2,000 and a CMS for ₹2,000." },
  { q: "What’s the difference between the webpage and the Business Website?", a: "The webpage lives on bhuj.kutchonline.com. The Business Website is a separate, complete 5 to 8 page site on your own custom domain." },
  { q: "What goes on my webpage?", a: "Your products, services and photos — all in one clean page that customers can open from your listing." },
  { q: "How do I get started?", a: "Tap any plan button below. It opens WhatsApp with a ready message — just add your business name." },
];

const offerSchema = [
  { name: "Get Verified", desc: "Verified badge on your listing on bhuj.kutchonline.com, shown ahead of unverified listings.", price: "899" },
  { name: "Top Rated + Webpage", desc: "Top Rated badge plus your own webpage with products, services and photos on bhuj.kutchonline.com.", price: "1999" },
  { name: "Business Website", desc: "A complete 5 to 8 page business website with custom domain setup, WhatsApp and tap-to-call links, Google Maps, contact form and photo gallery.", price: "6999" },
].map(o => ({
  "@type": "Product",
  "name": o.name,
  "description": o.desc,
  "brand": { "@type": "Brand", "name": "bhuj.kutchonline.com" },
  "offers": { "@type": "Offer", "price": o.price, "priceCurrency": "INR", "url": "https://bhuj.kutchonline.com/offers", "availability": "https://schema.org/InStock" },
}));

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    ...offerSchema,
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://bhuj.kutchonline.com/" },
        { "@type": "ListItem", "position": 2, "name": "Offers", "item": "https://bhuj.kutchonline.com/offers" },
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
    },
  ],
});
---

<BhujLayout
  title="Get Verified & Top Rated in Bhuj – Offers | bhuj.kutchonline.com"
  description="Be the business Bhuj calls first. Get Verified (₹899 + GST) Top Rated with your own webpage (₹1999 + GST), or a complete 5 to 8 page Business Website (₹6,999) on bhuj.kutchonline.com."
  canonicalPath="offers"
  structuredData={structuredData}
  bodyClass="page-offers"
>
  <main class="ob">

    <!-- ── HERO ──────────────────────────────────────────── -->
    <section class="ob-hero ob-wrap">
      <div class="ob-hero-copy">
        <span class="ob-eyebrow"><img src={em("🚀")} alt="" width="20" height="20" /> For businesses in Bhuj</span>
        <h1>Be the business <span>Bhuj calls first.</span></h1>
        <p class="ob-lead">Earn a Verified or Top Rated badge and move up your category. People trust the badge — and then they pick up the phone.</p>
        <p class="ob-gu">ભુજમાં સૌથી પહેલો કૉલ તમારો હોય.</p>
        <div class="ob-cta-row">
          <a href="#plans" class="ob-btn ob-btn-pink">See plans <span aria-hidden="true">→</span></a>
          <a href={wa("Hi! I want to know more about Verified and Top Rated.")} target="_blank" rel="noopener" class="ob-btn ob-btn-line">
            <img src={em("📲")} alt="" width="22" height="22" /> Chat on WhatsApp
          </a>
        </div>
      </div>

      <!-- a live-looking listing card, built from HTML -->
      <div class="ob-demo" aria-hidden="true">
        <img class="ob-float ob-float-1" src={em("🏆")} alt="" width="76" height="76" />
        <img class="ob-float ob-float-2" src={em("⭐")} alt="" width="58" height="58" />
        <img class="ob-float ob-float-3" src={em("📞")} alt="" width="62" height="62" />
        <div class="ob-card ob-card-back"></div>
        <div class="ob-card ob-card-main">
          <div class="ob-card-top">
            <span class="ob-avatar">Y</span>
            <div>
              <strong>Your Business Name</strong>
              <small>Bhuj · Your category</small>
            </div>
          </div>
          <div class="ob-card-badges">
            <span class="ob-pill ob-pill-blue">★ Trusted</span>
            <span class="ob-pill ob-pill-green">✓ Verified</span>
          </div>
          <div class="ob-card-call">📞 98250 XXXXX <b>Call Now</b></div>
        </div>
      </div>
    </section>

    <!-- ── PLANS ─────────────────────────────────────────── -->
    <section id="plans" class="ob-wrap ob-block">
      <header class="ob-head">
        <span class="ob-kicker">Pick your boost</span>
        <h2>Three plans. One goal: more calls.</h2>
      </header>
      <div class="ob-plans">
        {plans.map(p => (
          <article class={`ob-plan ${p.hot ? "ob-plan-hot" : ""}`}>
            <span class="ob-tag">{p.tag}</span>
            <img class="ob-plan-emoji" src={em(p.emoji)} alt="" width="92" height="92" />
            <h3>{p.name}</h3>
            <p class="ob-plan-line">{p.line}</p>
            <div class="ob-price"><sup>₹</sup>{p.price}<span>{p.unit === undefined ? <>+ GST<br />per year</> : p.unit}</span></div>
            {p.extras && <ul class="ob-extras">{p.extras.map(t => <li>{t}</li>)}</ul>}
            <ul>{p.points.map(t => <li>{t}</li>)}</ul>
            <a href={wa(p.msg)} target="_blank" rel="noopener" class={`ob-btn ${p.hot ? "ob-btn-pink" : "ob-btn-line"} ob-btn-wide`}>{p.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <!-- ── PERKS (bento) ─────────────────────────────────── -->
    <section class="ob-wrap ob-block">
      <header class="ob-head">
        <span class="ob-kicker">Why it works</span>
        <h2>Small badge. Big difference.</h2>
      </header>
      <div class="ob-bento">
        {perks.map((k, i) => (
          <div class={`ob-tile ob-tile-${i + 1}`}>
            <img src={em(k.emoji)} alt="" width="56" height="56" loading="lazy" />
            <h3>{k.title}</h3>
            <p>{k.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── STEPS ─────────────────────────────────────────── -->
    <section class="ob-wrap ob-block">
      <header class="ob-head">
        <span class="ob-kicker">Simple as 1-2-3</span>
        <h2>From message to live listing</h2>
      </header>
      <ol class="ob-steps">
        {steps.map((s, i) => (
          <li>
            <span class="ob-step-n">{i + 1}</span>
            <img src={em(s.emoji)} alt="" width="52" height="52" loading="lazy" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ── VOICES ────────────────────────────────────────── -->
    <section class="ob-wrap ob-block">
      <header class="ob-head">
        <span class="ob-kicker">Heard from Bhuj</span>
        <h2>Businesses that already did it</h2>
      </header>
      <div class="ob-voices">
        <figure>
          <blockquote>“Top Rated Badge મળ્યા પછી ઇન્કવાયરી કોલ્સમાં ઘણો વધારો થયો છે.”</blockquote>
          <figcaption><b>Hitesh Soni</b> · Insurance</figcaption>
        </figure>
        <figure>
          <blockquote>“bhuj.kutchonline.com સાથે જોડાવું એ મારા બિઝનેસ માટે બેસ્ટ નિર્ણય હતો.”</blockquote>
          <figcaption><b>Pradip Shah</b> · Real Estate</figcaption>
        </figure>
      </div>
    </section>

    <!-- ── FAQ ───────────────────────────────────────────── -->
    <section class="ob-wrap ob-block ob-faq">
      <header class="ob-head">
        <span class="ob-kicker">Quick answers</span>
        <h2>Before you ask…</h2>
      </header>
      <div class="ob-faq-list">
        {faqs.map(f => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ── FINAL CTA ─────────────────────────────────────── -->
    <section class="ob-wrap ob-block">
      <div class="ob-final">
        <img src={em("📞")} alt="" width="72" height="72" loading="lazy" />
        <h2>Ready to be Bhuj’s first call?</h2>
        <p>Say hi on WhatsApp — we’ll take it from there.</p>
        <a href={wa("Hi! I’m ready to get my business Verified on bhuj.kutchonline.com.")} target="_blank" rel="noopener" class="ob-btn ob-btn-white">Start on WhatsApp <span aria-hidden="true">→</span></a>
      </div>
    </section>

  </main>
</BhujLayout>

<style is:global>
  .ob {
    --pink: #ec1b8f; --pink-2: #ff5fb0; --deep: #8e0f5c; --ink: #2b1424; --muted: #7d5c70; --line: #f4d5e6; --soft: #fff5fa;
    background: #fff; color: var(--ink); font-family: 'Outfit', sans-serif; padding: 20px 0 30px; overflow: hidden;
  }
  .ob * { box-sizing: border-box; }
  .ob-wrap { max-width: 1120px; margin: 0 auto; padding: 0 22px; }
  .ob-block { padding-top: 84px; }
  .ob h1, .ob h2, .ob h3 { font-family: 'Space Grotesk', 'Outfit', sans-serif; margin: 0; letter-spacing: -.025em; }
  .ob p { margin: 0; }

  /* buttons */
  .ob-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 28px; border-radius: 999px;
    font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: .98rem; text-decoration: none; cursor: pointer;
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
  }
  .ob-btn:hover { transform: translateY(-3px); }
  .ob-btn-pink { color: #fff; background: linear-gradient(135deg, var(--pink-2), var(--pink)); box-shadow: 0 14px 30px -10px rgba(236,27,143,.65); }
  .ob-btn-line { color: var(--pink); background: #fff; border: 2px solid var(--line); }
  .ob-btn-line:hover { border-color: var(--pink-2); }
  .ob-btn-white { color: var(--pink); background: #fff; box-shadow: 0 14px 30px -12px rgba(80,0,50,.5); }
  .ob-btn-wide { width: 100%; }
  .ob-btn img { display: block; }

  /* hero */
  .ob-hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; padding-top: 44px; }
  .ob-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 7px 16px 7px 12px; border-radius: 999px; background: var(--soft); border: 1px solid var(--line); font-weight: 700; font-size: .85rem; color: var(--deep); }
  .ob-hero h1 { font-size: clamp(2.5rem, 5.6vw, 4.4rem); line-height: 1.04; font-weight: 800; margin: 22px 0 18px; }
  .ob-hero h1 span { background: linear-gradient(90deg, var(--pink), #ff7a59); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .ob-lead { font-size: 1.15rem; line-height: 1.65; color: var(--muted); max-width: 520px; }
  .ob-gu { margin-top: 12px; font-weight: 600; color: var(--deep); }
  .ob-cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }

  /* demo card */
  .ob-demo { position: relative; min-height: 340px; display: grid; place-items: center; }
  .ob-card { background: #fff; border-radius: 26px; border: 1px solid var(--line); }
  .ob-card-back { position: absolute; width: 78%; height: 210px; transform: rotate(-6deg) translate(-8%, 10%); background: var(--soft); }
  .ob-card-main { position: relative; width: 88%; padding: 26px; box-shadow: 0 30px 60px -24px rgba(236,27,143,.45); }
  .ob-card-top { display: flex; align-items: center; gap: 14px; }
  .ob-avatar { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 16px; background: linear-gradient(135deg, var(--pink-2), var(--pink)); color: #fff; font: 800 1.3rem 'Space Grotesk', sans-serif; }
  .ob-card-top strong { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 1.15rem; }
  .ob-card-top small { color: var(--muted); }
  .ob-card-badges { display: flex; gap: 10px; margin: 20px 0; }
  .ob-pill { padding: 7px 14px; border-radius: 999px; font-weight: 800; font-size: .78rem; letter-spacing: .04em; text-transform: uppercase; }
  .ob-pill-blue { background: #e8f2fe; color: #2563eb; }
  .ob-pill-green { background: #e6f8ee; color: #1f9d55; }
  .ob-card-call { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px 12px 18px; border-radius: 16px; background: var(--soft); font-weight: 700; }
  .ob-card-call b { padding: 9px 18px; border-radius: 999px; background: linear-gradient(135deg, var(--pink-2), var(--pink)); color: #fff; font-size: .85rem; }
  .ob-float { position: absolute; z-index: 2; filter: drop-shadow(0 12px 14px rgba(120,0,70,.25)); animation: obFloat 5s ease-in-out infinite; }
  .ob-float-1 { top: -8px; right: 2%; }
  .ob-float-2 { bottom: 12%; left: -2%; animation-delay: -1.6s; }
  .ob-float-3 { bottom: -14px; right: 12%; animation-delay: -3.2s; }
  @keyframes obFloat { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-14px) rotate(5deg); } }

  /* section heads */
  .ob-head { text-align: center; margin-bottom: 44px; }
  .ob-kicker { display: inline-block; font-weight: 800; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; color: var(--pink); margin-bottom: 12px; }
  .ob-head h2 { font-size: clamp(1.9rem, 3.8vw, 2.9rem); font-weight: 800; line-height: 1.1; }

  /* plans */
  .ob-plans { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; max-width: 960px; margin: 0 auto; }
  .ob-plan { position: relative; display: flex; flex-direction: column; padding: 38px 30px 32px; border-radius: 34px; border: 2px solid var(--line); background: #fff; transition: transform .3s ease, box-shadow .3s ease; }
  .ob-plan:hover { transform: translateY(-6px); box-shadow: 0 30px 50px -28px rgba(236,27,143,.5); }
  .ob-plan-hot { border-color: var(--pink); box-shadow: 0 30px 60px -30px rgba(236,27,143,.55); }
  .ob-tag { position: absolute; top: 22px; right: 22px; padding: 6px 14px; border-radius: 999px; background: var(--soft); color: var(--deep); font-weight: 800; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .ob-plan-hot .ob-tag { background: var(--pink); color: #fff; }
  .ob-plan-emoji { display: block; margin-bottom: 14px; filter: drop-shadow(0 14px 14px rgba(120,0,70,.22)); }
  .ob-plan h3 { font-size: 1.45rem; font-weight: 800; line-height: 1.2; min-height: 2.4em; }
  .ob-plan-line { color: var(--muted); margin-top: 6px; min-height: 4.6em; }
  @media (max-width: 860px) { .ob-plan h3, .ob-plan-line { min-height: 0; } }
  .ob-price { display: flex; align-items: flex-start; gap: 6px; margin: 22px 0 6px; font: 800 3.6rem/1 'Space Grotesk', sans-serif; color: var(--pink); letter-spacing: -.04em; }
  .ob-price sup { font-size: 1.7rem; margin-top: 8px; }
  .ob-price span { align-self: flex-end; margin-bottom: 8px; font: 700 .82rem/1.25 'Outfit', sans-serif; color: var(--muted); letter-spacing: 0; }
  .ob-plan .ob-btn { margin-top: auto; }
  .ob-plan ul.ob-extras { margin: 6px 0 0; padding: 14px 16px; border-radius: 16px; background: var(--soft); border: 1px dashed #f0b6d4; gap: 8px; }
  .ob-plan ul.ob-extras li { padding-left: 0; font-size: .86rem; font-weight: 600; color: var(--deep); }
  .ob-plan ul.ob-extras li::before { content: none; }
  .ob-plan ul { list-style: none; margin: 20px 0 28px; padding: 0; display: grid; gap: 12px; }
  .ob-plan li { position: relative; padding-left: 32px; color: #5d4153; line-height: 1.45; }
  .ob-plan li::before { content: '✓'; position: absolute; left: 0; top: 1px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--soft); border: 1px solid var(--line); color: var(--pink); font-size: .72rem; font-weight: 800; }

  /* bento */
  .ob-bento { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: minmax(190px, auto); gap: 20px; }
  .ob-tile { padding: 28px; border-radius: 30px; border: 1px solid var(--line); background: #fff; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; position: relative; overflow: hidden; transition: transform .3s ease; }
  .ob-tile:hover { transform: translateY(-5px); }
  .ob-tile img { position: absolute; top: 22px; left: 26px; filter: drop-shadow(0 10px 10px rgba(120,0,70,.22)); }
  .ob-tile h3 { font-size: 1.3rem; font-weight: 800; }
  .ob-tile p { color: var(--muted); line-height: 1.55; }
  .ob-tile-1 { grid-column: span 4; background: var(--soft); }
  .ob-tile-2 { grid-column: span 2; }
  .ob-tile-3 { grid-column: span 2; }
  .ob-tile-4 { grid-column: span 4; background: linear-gradient(135deg, var(--pink-2), var(--pink)); border: 0; }
  .ob-tile-4 h3, .ob-tile-4 p { color: #fff; }
  .ob-tile-4 p { opacity: .92; }

  /* steps */
  .ob-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; position: relative; }
  .ob-steps li { position: relative; padding: 30px 26px 28px; border-radius: 28px; background: var(--soft); border: 1px dashed #f0b6d4; text-align: center; }
  .ob-steps img { display: block; margin: 0 auto 12px; filter: drop-shadow(0 10px 10px rgba(120,0,70,.22)); }
  .ob-step-n { position: absolute; top: -18px; left: 50%; transform: translateX(-50%); display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--pink); color: #fff; font: 800 1rem 'Space Grotesk', sans-serif; box-shadow: 0 8px 16px -6px rgba(236,27,143,.6); }
  .ob-steps h3 { font-size: 1.2rem; font-weight: 800; margin-bottom: 6px; }
  .ob-steps p { color: var(--muted); line-height: 1.55; }

  /* voices */
  .ob-voices { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 900px; margin: 0 auto; }
  .ob-voices figure { margin: 0; padding: 30px 32px; border-radius: 30px; border: 1px solid var(--line); position: relative; background: #fff; }
  .ob-voices figure::before { content: '“'; position: absolute; top: 4px; left: 22px; font: 800 5rem/1 'Space Grotesk', sans-serif; color: #ffd3e8; }
  .ob-voices blockquote { margin: 22px 0 16px; line-height: 1.7; font-size: 1.05rem; position: relative; }
  .ob-voices figcaption { color: var(--muted); }
  .ob-voices figcaption b { color: var(--pink); }

  /* faq */
  .ob-faq-list { max-width: 760px; margin: 0 auto; display: grid; gap: 14px; }
  .ob-faq details { border: 1px solid var(--line); border-radius: 22px; background: #fff; padding: 0 26px; transition: background .2s; }
  .ob-faq details[open] { background: var(--soft); }
  .ob-faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 0; font: 700 1.08rem 'Space Grotesk', sans-serif; }
  .ob-faq summary::-webkit-details-marker { display: none; }
