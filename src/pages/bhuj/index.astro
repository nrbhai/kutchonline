---
import BhujLayout from "../../layouts/BhujLayout.astro";
import data from "../../data/data.json";

// For the tickers, let's extract the verified and top rated providers just like in script.js
const allProviders = [];
data.forEach(category => {
  const catName = category.name || "Local Business";
  const catId = category.id || "";
  const catLink = catId ? `${catId}-in-bhuj.html` : "#";
  
  if (category.providers) {
    category.providers.forEach(p => {
      const webpage = (p.webpage || "").trim();
      const link = webpage || catLink;
      
      const isTruthy = (value) => {
        if (typeof value === 'boolean') return value;
        if (typeof value === 'number') return value === 1;
        const text = String(value || '').toLowerCase().trim();
        return text === 'yes' || text === 'true' || text === '1';
      };
      
      const verified = isTruthy(p.verified) || isTruthy(p.Verified);
      const topRated = isTruthy(p.top_rated) || isTruthy(p.topRated) || isTruthy(p['Top Rated']) || isTruthy(p.ratings) || isTruthy(p.Ratings);
      
      allProviders.push({
        name: p.name,
        category: catName,
        link,
        verified,
        topRated
      });
    });
  }
});

// Deduplicate providers by name case-insensitively
const deduplicatedProvidersMap = new Map();
allProviders.forEach(p => {
  const key = p.name.toLowerCase().trim();
  if (!deduplicatedProvidersMap.has(key)) {
    deduplicatedProvidersMap.set(key, p);
  } else {
    const existing = deduplicatedProvidersMap.get(key);
    if ((!existing.link || existing.link === '#') && p.link && p.link !== '#') {
      existing.link = p.link;
    }
    existing.verified = existing.verified || p.verified;
    existing.topRated = existing.topRated || p.topRated;
    deduplicatedProvidersMap.set(key, existing);
  }
});

const verifiedProviders = Array.from(deduplicatedProvidersMap.values())
  .filter(p => p.verified)
  .slice(0, 18);

const topRatedProviders = Array.from(deduplicatedProvidersMap.values())
  .filter(p => p.topRated)
  .slice(0, 18);

// Sort categories alphabetically
const sortedCategories = [...data].sort((a, b) => a.name.localeCompare(b.name));

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": "bhuj.kutchonline.com",
      "url": "https://bhuj.kutchonline.com",
      "logo": "https://bhuj.kutchonline.com/assets/public/images/bhujonline-logo.png",
      "image": "https://bhuj.kutchonline.com/assets/public/images/bhujonline-logo.png",
      "description": "Local services directory for Bhuj, Kutch, Gujarat. Find 650+ verified providers including electricians, plumbers, doctors, and more.",
      "telephone": "+91-9825034580",
      "email": "contact@kutchonline.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Dhatia Falia 3 Ways, Anam Ring Road",
        "addressLocality": "Bhuj",
        "addressRegion": "Gujarat",
        "postalCode": "370001",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "23.2420",
        "longitude": "69.6669"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday"
        ],
        "opens": "09:00",
        "closes": "20:00"
      },
      "areaServed": {
        "@type": "City",
        "name": "Bhuj"
      },
      "sameAs": [
        "https://www.facebook.com/kutchonline",
        "https://www.instagram.com/kutchonline"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Where can I find a plumber in Bhuj?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can find verified plumbers in Bhuj by visiting bhuj.kutchonline.com and searching for 'Plumber'. We list providers from areas like Madhapar, Sanskar Nagar, and Mirzapar."
          }
        },
        {
          "@type": "Question",
          "name": "Which electrician is available near me in Bhuj?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "bhuj.kutchonline.com lists top-rated local electricians available across Bhuj. Simply use the search box or tap the 'Electrician' icon to see a list of verified professionals with their contact numbers."
          }
        }
      ]
    },
    {
      "@type": "WebSite",
      "name": "bhuj.kutchonline.com",
      "url": "https://bhuj.kutchonline.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://bhuj.kutchonline.com/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  ]
});
