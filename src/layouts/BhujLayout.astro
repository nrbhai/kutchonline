---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalPath?: string;
  structuredData?: string;
  bodyClass?: string;
  robots?: string;
}

const {
  title = "bhuj.kutchonline.com – Bhuj Local Business Directory | Kutch",
  description = "Find 650+ verified local service providers in Bhuj. Electricians, plumbers, doctors, CA, computer repair & more.",
  keywords = "Bhuj services, local services Bhuj, electrician Bhuj, plumber Bhuj, verified providers Bhuj",
  canonicalPath = "",
  structuredData,
  bodyClass = "",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
} = Astro.props;

const canonicalUrl = `https://bhuj.kutchonline.com/${canonicalPath}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#e91e8c">
    <meta name="robots" content={robots}>
    <meta name="format-detection" content="telephone=yes">

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title}>
    <meta name="description" content={description}>
    <meta name="keywords" content={keywords}>
    <meta name="author" content="Hari Tech Solutions">

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl}>

    <!-- Geo-Targeting Meta Tags -->
    <meta name="geo.region" content="IN-GJ">
    <meta name="geo.placename" content="Bhuj">
    <meta name="geo.position" content="23.2420;69.6669">
    <meta name="ICBM" content="23.2420, 69.6669">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://bhuj.kutchonline.com/assets/public/images/bhujonline-logo.png">
    <meta property="og:locale" content="en_IN">
    <meta property="og:image:alt" content="bhuj.kutchonline.com – local business directory for Bhuj, Kutch">
    <meta property="og:site_name" content="Bhuj Online">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content={canonicalUrl}>
    <meta property="twitter:title" content={title}>
    <meta property="twitter:description" content={description}>
    <meta property="twitter:image" content="https://bhuj.kutchonline.com/assets/public/images/bhujonline-logo.png">

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous">

    <!-- Global Stylesheet -->
    <link rel="stylesheet" href="/assets/css/style.css" />

    {structuredData && (
      <script type="application/ld+json" set:html={structuredData} />
    )}
</head>
<body class={`has-topbar ${bodyClass}`}>
    <div class="container">
        <!-- Header / Navigation -->
        <header class="topbar" aria-label="Top navigation">
            <div class="topbar-inner">
                <a class="topbar-brand" href="/bhuj/" aria-label="bhuj.kutchonline.com home">
                    <span class="topbar-brand-accent">bhuj.</span><span class="topbar-brand-rest">kutchonline</span><span class="topbar-brand-tld">.com</span>
                </a>

                <nav class="main-nav" aria-label="Primary">
                    <div class="nav-links">
                        <a href="/bhuj/" class="nav-link"><i class="fa-solid fa-house" aria-hidden="true"></i><span>Home</span></a>
                        <a href="/bhuj/offers" class="nav-link"><i class="fa-solid fa-tag" aria-hidden="true"></i><span>Offers</span></a>
                        <a href="/bhuj/about" class="nav-link"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>About</span></a>
                        <a href="/bhuj/about-bhuj" class="nav-link"><i class="fa-solid fa-landmark" aria-hidden="true"></i><span>About Bhuj</span></a>
                    </div>
                </nav>

                <a href="https://forms.fillout.com/t/7mRL9KysBPus" target="_blank" rel="noopener" class="topbar-cta" aria-label="List your business">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i><span>List Business</span>
                </a>
            </div>
        </header>

        <slot />

        <!-- Footer -->
        <footer class="ft" aria-label="Site footer">
            <div class="ft-inner">
                <a class="ft-brand" href="/bhuj/" aria-label="bhuj.kutchonline.com home"><span>bhuj.</span>kutchonline.com</a>
                <nav class="ft-links" aria-label="Footer navigation">
                    <a href="/bhuj/">Home</a>
                    <a href="/bhuj/offers">Offers</a>
                    <a href="/bhuj/about">About</a>
                    <a href="/bhuj/about-bhuj">About Bhuj</a>
                </nav>
                <div class="ft-contact">
                    <a href="tel:+919825034580">+91 98250 34580</a>
                    <a href="https://wa.me/919825034580" target="_blank" rel="noopener noreferrer">WhatsApp</a>
                    <a href="mailto:info@kutchonline.com">info@kutchonline.com</a>
                </div>
            </div>
            <p class="ft-copy">© {new Date().getFullYear()} bhuj.kutchonline.com &nbsp;·&nbsp; Mon – Sat, 9:00 AM – 8:00 PM &nbsp;·&nbsp; Made with ❤️ for Bhuj</p>
        </footer>
    </div>

    <!-- Scripts -->
    <script is:inline src="/assets/js/data.js"></script>
    <script is:inline src="/assets/js/iconMap.js"></script>
    <script is:inline src="/assets/js/script.js"></script>
</body>
</html>

<style is:global>
    /* ── TOPBAR — Dark Glassy Design ───────────────── */
    .topbar {
        background: rgba(6,11,24,0.88) !important;
        border-bottom: 1px solid rgba(255,255,255,0.07) !important;
        backdrop-filter: blur(20px) !important;
        -webkit-backdrop-filter: blur(20px) !important;
        box-shadow: 0 1px 0 rgba(255,255,255,0.04), 0 4px 24px rgba(0,0,0,0.3) !important;
    }

    .topbar-inner {
        padding: 0 24px !important;
        height: 58px !important;
        max-width: 1440px !important;
        display: grid !important;
        grid-template-columns: auto 1fr auto !important;
        align-items: center !important;
        gap: 16px !important;
    }

    /* Brand */
    .topbar-brand {
        font-family: 'Space Grotesk', sans-serif !important;
        font-weight: 800 !important;
        font-size: 1.25rem !important;
        letter-spacing: -0.04em !important;
        text-decoration: none !important;
        display: inline-flex !important;
        align-items: baseline !important;
        gap: 0 !important;
        white-space: nowrap !important;
    }
    .topbar-brand-accent  { color: #3b82f6 !important; }
    .topbar-brand-rest    { color: #f1f5f9 !important; }
    .topbar-brand-tld     { color: rgba(255,255,255,0.35) !important; font-weight: 700 !important; }

    /* Nav links */
    .topbar .main-nav {
        justify-self: center !important;
    }
    .topbar .nav-links {
        display: flex !important;
        align-items: center !important;
        gap: 2px !important;
        flex-wrap: nowrap !important;
        overflow-x: auto !important;
        scrollbar-width: none !important;
    }
    .topbar .nav-links::-webkit-scrollbar { display: none !important; }

    .topbar .nav-link {
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        padding: 7px 13px !important;
        border-radius: 10px !important;
        font-family: 'Space Grotesk', sans-serif !important;
        font-size: 0.82rem !important;
        font-weight: 700 !important;
        color: rgba(255,255,255,0.6) !important;
        text-decoration: none !important;
        transition: background 0.2s ease, color 0.2s ease !important;
        white-space: nowrap !important;
    }
    .topbar .nav-link i { font-size: 0.78rem !important; }
    .topbar .nav-link:hover {
        background: rgba(255,255,255,0.08) !important;
        color: #ffffff !important;
    }
    .topbar .nav-link.active,
    .topbar .nav-link.is-active {
        background: rgba(59,130,246,0.18) !important;
        color: #60a5fa !important;
    }

    /* CTA button */
    .topbar-cta {
        display: inline-flex !important;
        align-items: center !important;
        gap: 7px !important;
        padding: 8px 16px !important;
        background: #2563eb !important;
        color: #ffffff !important;
        font-family: 'Space Grotesk', sans-serif !important;
        font-size: 0.82rem !important;
        font-weight: 800 !important;
        border-radius: 10px !important;
        text-decoration: none !important;
        white-space: nowrap !important;
        box-shadow: 0 4px 14px rgba(37,99,235,0.35) !important;
        transition: all 0.2s ease !important;
        flex-shrink: 0 !important;
    }
    .topbar-cta:hover {
        background: #1d4ed8 !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 20px rgba(37,99,235,0.45) !important;
    }
    .topbar-cta i { font-size: 0.78rem !important; }

    /* Mobile toggle */
    .nav-toggle {
        background: rgba(255,255,255,0.08) !important;
        border: 1px solid rgba(255,255,255,0.12) !important;
        color: #ffffff !important;
        border-radius: 10px !important;
    }
    .nav-toggle-lines span {
        background: #ffffff !important;
    }

    /* Body */
    body {
        background-color: #ffffff !important;
        color: #0f172a !important;
    }
    /* Pure white page surfaces (no tinted section backdrops) */
    .page-offers main, .page-offers .section-pricing, .page-offers .section-testimonials,
    .jb-section.jb-section-light, .vcg-main {
        background: #ffffff !important;
    }

    /* Container padding — slim to match 58px navbar */
    body.has-topbar .container,
    .page-home .container,
    .page-category .container {
        padding-top: 58px !important;
    }

    /* Premium Styled Footer (bof-footer) */
    .bof-footer {
        margin-top: 40px !important;
        background: #0f172a !important; /* Deep Navy background for contrast */
        border-top: 1px solid rgba(37, 99, 235, 0.15) !important;
        padding: 48px 20px 28px !important;
        color: #ffffff !important;
    }

    .bof-footer-inner {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        display: grid !important;
        grid-template-columns: 1fr !important;
        gap: 32px !important;
    }

    @media (min-width: 768px) {
        .bof-footer-inner {
            grid-template-columns: 2fr 1fr !important;
            gap: 60px !important;
        }
    }

    .bof-col {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .bof-brand-link {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 800;
        text-transform: lowercase;
        letter-spacing: -0.03em;
        font-size: 1.6rem;
        text-decoration: none;
        display: inline-block;
    }

    .bof-brand-accent {
        color: #3b82f6 !important; /* Bright Blue brand */
    }

    .bof-brand-rest {
        color: #ffffff !important;
    }

    .bof-brand-dot {
        color: #3b82f6 !important;
    }

    .bof-tagline {
        margin: 0;
        color: #94a3b8 !important;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .bof-contact-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .bof-contact-item {
        color: #f1f5f9 !important;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: color 0.2s ease;
    }

    .bof-contact-item:hover {
        color: #3b82f6 !important;
    }

    .bof-contact-icon {
        font-size: 1rem;
        color: #3b82f6;
    }

    .bof-hours {
        margin: 0;
        color: #94a3b8 !important;
        font-size: 0.85rem;
    }

    .bof-col-title {
        font-size: 0.95rem !important;
        font-weight: 800 !important;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #3b82f6 !important;
        margin-bottom: 8px !important;
        margin-top: 0 !important;
    }

    .bof-nav {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .bof-nav-link {
        color: #e2e8f0 !important;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
        transition: color 0.2s ease;
        width: fit-content;
    }

    .bof-nav-link:hover {
        color: #3b82f6 !important;
    }

    .bof-bar {
        max-width: 1200px;
        margin: 30px auto 0;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        padding-top: 20px;
        display: flex;
        justify-content: space-between;
        color: #94a3b8 !important;
        font-size: 0.82rem;
    }
</style>

<style is:global>
    /* ── TOPBAR — Pink glassmorphism ─────────────────── */
    .topbar {
        background: linear-gradient(120deg, rgba(255,255,255,0.55) 0%, rgba(255,170,212,0.42) 50%, rgba(255,255,255,0.5) 100%) !important;
        border-bottom: 1px solid rgba(255,255,255,0.8) !important;
        backdrop-filter: blur(22px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(22px) saturate(180%) !important;
        box-shadow: 0 10px 34px -10px rgba(233,30,140,0.35), inset 0 -1px 0 rgba(233,30,140,0.12), inset 0 1px 0 rgba(255,255,255,0.9) !important;
    }
    .topbar-brand-accent { color: #e91e8c !important; }
    .topbar-brand-rest   { color: #6b1646 !important; }
    .topbar-brand-tld    { color: rgba(107,22,70,0.45) !important; }
    .topbar .nav-link {
        color: #8a2d62 !important;
        border: 1px solid transparent !important;
        border-radius: 14px !important;
    }
    .topbar .nav-link:hover {
        background: rgba(255,255,255,0.65) !important;
        border-color: rgba(255,255,255,0.9) !important;
        color: #e91e8c !important;
        box-shadow: 0 6px 16px -6px rgba(233,30,140,0.4) !important;
    }
    .topbar .nav-link.active, .topbar .nav-link.is-active, .topbar .nav-link[aria-current="page"] {
        background: rgba(255,255,255,0.75) !important;
        border-color: rgba(255,255,255,0.95) !important;
        color: #e91e8c !important;
        box-shadow: 0 6px 16px -6px rgba(233,30,140,0.45), inset 0 1px 0 #fff !important;
    }
    .topbar-cta {
        background: linear-gradient(135deg, #ff4fa8, #e91e8c 55%, #c4127a) !important;
        border-radius: 14px !important;
        box-shadow: 0 10px 22px -8px rgba(233,30,140,0.6), inset 0 1px 0 rgba(255,255,255,0.5) !important;
    }
    .topbar-cta:hover {
        background: linear-gradient(135deg, #ff5fb2, #f0269a 55%, #cc1581) !important;
        box-shadow: 0 14px 26px -8px rgba(233,30,140,0.7), inset 0 1px 0 rgba(255,255,255,0.5) !important;
    }
</style>
<script is:inline>
  // mark the current page in the nav
  (function () {
    var path = location.pathname.replace(/\/+$/, '') || '/';
    document.querySelectorAll('.topbar .nav-link').forEach(function (a) {
      var href = a.getAttribute('href').replace(/\/+$/, '') || '/';
      if (href === path || (href !== '/bhuj' && path.indexOf(href) === 0)) a.setAttribute('aria-current', 'page');
    });
  })();
</script>

<style is:global>
    /* ── FOOTER — simple, light, pink accents ───────── */
    .ft {
        margin-top: 56px; padding: 30px 24px 22px; background: #ffffff;
        border-top: 1px solid rgba(233,30,140,0.18);
        box-shadow: 0 -12px 30px -18px rgba(233,30,140,0.25);
        font-family: 'Outfit', sans-serif;
    }
    .ft-inner {
        max-width: 1120px; margin: 0 auto; display: flex; align-items: center;
        justify-content: space-between; gap: 18px 32px; flex-wrap: wrap;
    }
    .ft-brand { font-family: 'Space Grotesk', sans-serif; font-weight: 800; font-size: 1.15rem; letter-spacing: -0.03em; color: #6b1646; text-decoration: none; }
    .ft-brand span { color: #e91e8c; }
    .ft-links, .ft-contact { display: flex; gap: 6px 22px; flex-wrap: wrap; align-items: center; }
    .ft-links a, .ft-contact a { color: #7a3a5e; font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: color .2s; }
    .ft-links a:hover, .ft-contact a:hover { color: #e91e8c; }
    .ft-copy { max-width: 1120px; margin: 22px auto 0; padding-top: 16px; border-top: 1px solid #f3dce8; text-align: center; font-size: 0.8rem; color: #a07890; }
    @media (max-width: 720px) {
        .ft-inner { flex-direction: column; text-align: center; }
        .ft-links, .ft-contact { justify-content: center; }
    }
</style>

<style is:global>
    /* ── RESPONSIVE — phone & tablet ───────────────── */
    html, body { overflow-x: clip; max-width: 100%; }
    img, video, svg { max-width: 100%; height: auto; }
    .topbar-brand { min-width: 0; }

    /* tablet: keep the glass nav on one line */
    @media (min-width: 601px) and (max-width: 900px) {
        .topbar-inner { padding: 0 14px !important; gap: 8px !important; }
        .topbar-brand { font-size: 1.05rem !important; }
        .topbar .nav-link { padding: 7px 9px !important; font-size: 0.78rem !important; gap: 5px !important; }
        .topbar-cta { padding: 8px 12px !important; }
        .topbar-cta span { display: none !important; }
        .ft-inner { justify-content: center; text-align: center; }
    }

    /* phone: pink glass hamburger + dropdown */
    @media (max-width: 600px) {
        .topbar-inner { display: flex !important; padding: 0 14px !important; gap: 10px !important; }
        .topbar-brand { font-size: 1.05rem !important; margin-right: auto; }
        .topbar-cta { order: 2; }
        .nav-toggle {
            order: 3; width: 42px !important; height: 42px !important; border-radius: 14px !important;
            background: rgba(255,255,255,0.7) !important; border: 1px solid rgba(255,255,255,0.95) !important;
            box-shadow: 0 8px 18px -8px rgba(233,30,140,0.45), inset 0 1px 0 #fff !important;
        }
        .nav-toggle-lines span { background: #e91e8c !important; }
        .topbar .main-nav {
            left: 0 !important; right: 0 !important; width: 100% !important; max-width: none !important; justify-self: stretch !important;
            background: linear-gradient(160deg, rgba(255,255,255,0.96), rgba(255,214,234,0.94)) !important;
            backdrop-filter: blur(22px) saturate(180%) !important; -webkit-backdrop-filter: blur(22px) saturate(180%) !important;
            border-bottom: 1px solid rgba(233,30,140,0.2) !important;
            box-shadow: 0 22px 40px -14px rgba(233,30,140,0.4) !important;
        }
        .topbar .nav-link { color: #8a2d62 !important; font-size: 1rem !important; padding: 13px 14px !important; }
        .topbar .nav-link:hover, .topbar .nav-link[aria-current="page"] { background: rgba(255,255,255,0.8) !important; color: #e91e8c !important; }
        .ft { padding: 26px 18px 20px; }
        .ft-copy { font-size: 0.74rem; }
    }
    @media (max-width: 380px) {
        .topbar-brand-tld { display: none !important; }
    }
</style>
