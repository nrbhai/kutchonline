<script>
  // Simple Waitlist Submission Handler
  const waitlistForm = document.getElementById('waitlist-form');
  const successMessage = document.getElementById('success-message');

  if (waitlistForm && successMessage) {
    waitlistForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const emailInput = document.getElementById('email-input') as HTMLInputElement | null;
      if (emailInput && emailInput.value) {
        // Save to local storage for demo/persistence on user side
        const waitlist = JSON.parse(localStorage.getItem('kutchonline_waitlist') || '[]');
        waitlist.push({
          email: emailInput.value,
          timestamp: new Date().toISOString()
        });
        localStorage.setItem('kutchonline_waitlist', JSON.stringify(waitlist));

        // Hide form and show success message
        waitlistForm.classList.add('hidden');
        successMessage.classList.remove('hidden');
      }
    });
  }
</script>
