---
interface Props {
  rating: number; // e.g. 4.8
  reviewsCount?: number;
  showNumeric?: boolean;
  size?: "sm" | "md" | "lg";
}

const { rating, reviewsCount, showNumeric = true, size = "md" } = Astro.props;

// Calculate stars
const fullStars = Math.floor(rating);
const hasHalfStar = rating - fullStars >= 0.4;
const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
---

<div class={`rating-wrapper size-${size}`}>
  <div class="stars-row" aria-label={`Rating: ${rating} out of 5 stars`}>
    {Array.from({ length: fullStars }).map(() => (
      <span class="star star-full" aria-hidden="true">★</span>
    ))}
    {hasHalfStar && (
      <span class="star star-half" aria-hidden="true">★</span>
    )}
    {Array.from({ length: emptyStars }).map(() => (
      <span class="star star-empty" aria-hidden="true">★</span>
    ))}
  </div>
  
  {showNumeric && (
    <span class="rating-number">{rating.toFixed(1)}</span>
  )}

  {reviewsCount !== undefined && (
    <span class="reviews-count">({reviewsCount.toLocaleString()})</span>
  )}
</div>

<style>
  .rating-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
  }

  .stars-row {
    display: flex;
    align-items: center;
    gap: 2px;
    color: var(--color-star, #eab308);
  }

  .star {
    user-select: none;
  }

  .star-empty {
    color: #cbd5e1;
  }

  .star-half {
    position: relative;
    background: linear-gradient(90deg, #eab308 50%, #cbd5e1 50%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .rating-number {
    font-weight: 700;
    color: var(--text-main, #0f172a);
  }

  .reviews-count {
    color: var(--text-muted, #64748b);
  }

  .size-sm {
    font-size: 0.75rem;
  }
  .size-sm .stars-row {
    font-size: 0.85rem;
  }

  .size-md {
    font-size: 0.875rem;
  }
  .size-md .stars-row {
    font-size: 1rem;
  }

  .size-lg {
    font-size: 1.05rem;
  }
  .size-lg .stars-row {
    font-size: 1.25rem;
  }
</style>
