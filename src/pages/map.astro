  }

  .tip-box {
    background-color: rgba(217, 119, 6, 0.02);
    border: 1px solid rgba(217, 119, 6, 0.1);
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tip-header {
