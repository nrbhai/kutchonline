---
import BhujLayout from "../../layouts/BhujLayout.astro";
---

<BhujLayout
  title="Bhuj Tourism & Guide: History, Culture, Attractions & Food | bhuj.kutchonline.com"
  description="Discover Bhuj, the cultural capital of Kutch. Learn about its rich history, heritage sites, local attractions, and what makes this ancient city special."
  canonicalPath="about-bhuj"
>
  <main style="padding-top: 20px;">
      <!-- Hero Section -->
      <section id="about-bhuj-hero" class="premium-hero" style="position: relative; height: 60vh; min-height: 400px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #000; border-radius: 24px; margin-bottom: 30px; border-bottom: 2px solid #2563eb;">
          <img src="/assets/public/images/about-bhuj/hero-bhuj.webp" alt="Bhuj Skyline" class="hero-bg-img" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; filter: saturate(1.1) brightness(0.65);">
          <div class="hero-content" style="position: relative; z-index: 2; text-align: center; max-width: 900px; padding: 20px;">
              <span class="hero-kicker" style="font-family: 'Outfit', sans-serif; text-transform: uppercase; letter-spacing: 0.2em; color: #2563eb; font-weight: 600; font-size: 0.9rem; margin-bottom: 1rem; display: block; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">Welcome to the Heart of Kutch</span>
              <h1 class="hero-title" style="font-family: 'Outfit', sans-serif; font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 700; color: #fff; line-height: 1; margin-bottom: 1.5rem; text-shadow: 0 2px 8px rgba(0,0,0,0.8);">About Bhuj</h1>
              <div class="hero-glass-box" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(37, 99, 235, 0.2); padding: 1rem 2rem; border-radius: 100px; display: inline-flex; align-items: center; gap: 15px; color: #2563eb; font-weight: 600; box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);">
                  <span class="material-icons" style="color: #2563eb;">location_on</span>
                  <span style="color: #0f172a;">370 001, Kutch, Gujarat, India</span>
              </div>
          </div>
      </section>

      <!-- Main Content Wrapper -->
      <div class="wrap-wide">
          
          <!-- Quick Facts Bar -->
          <div id="about-bhuj-facts" class="facts-bar" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 30px; padding: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 30px; box-shadow: 0 20px 40px rgba(15, 23, 42, 0.05); margin-top: -60px; position: relative; z-index: 10;">
              <div class="fact-card" style="display: flex; flex-direction: column; gap: 5px; padding: 0 20px; border-right: 1px solid #e2e8f0;">
                  <span class="fact-label" style="font-size: 0.8rem; font-weight: 700; color: #2563eb; text-transform: uppercase; letter-spacing: 0.05em;">Location</span>
                  <span class="fact-value" style="font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 700; color: #0f172a;">Kutch District</span>
              </div>
              <div class="fact-card" style="display: flex; flex-direction: column; gap: 5px; padding: 0 20px; border-right: 1px solid #e2e8f0;">
                  <span class="fact-label" style="font-size: 0.8rem; font-weight: 700; color: #2563eb; text-transform: uppercase; letter-spacing: 0.05em;">Population</span>
                  <span class="fact-value" style="font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 700; color: #0f172a;">Approx. 3 Lacs</span>
              </div>
              <div class="fact-card" style="display: flex; flex-direction: column; gap: 5px; padding: 0 20px; border-right: 1px solid #e2e8f0;">
                  <span class="fact-label" style="font-size: 0.8rem; font-weight: 700; color: #2563eb; text-transform: uppercase; letter-spacing: 0.05em;">Main Languages</span>
                  <span class="fact-value" style="font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 700; color: #0f172a;">Kachchhi, Gujarati</span>
              </div>
              <div class="fact-card" style="display: flex; flex-direction: column; gap: 5px; padding: 0 20px;">
                  <span class="fact-label" style="font-size: 0.8rem; font-weight: 700; color: #2563eb; text-transform: uppercase; letter-spacing: 0.05em;">Best Season</span>
                  <span class="fact-value" style="font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 700; color: #0f172a;">October to March</span>
              </div>
          </div>

          <!-- Intro Story Section -->
           <section id="about-bhuj-story" class="story-container" style="display: flex; align-items: center; gap: 60px; padding: 80px 0; flex-wrap: wrap;">
              <div class="story-visual" style="flex: 1; min-width: 300px; position: relative;">
                  <img src="/assets/public/images/about-bhuj/bhuj2.webp" alt="Old Bhuj" class="story-img-main" style="width: 100%; border-radius: 32px; border: 1px solid #e2e8f0; box-shadow: 0 20px 30px rgba(15, 23, 42, 0.08);">
                  <img src="/assets/public/images/about-bhuj/bhuj9.webp" alt="Kutch Craft" class="story-img-secondary" style="position: absolute; bottom: -20px; right: -20px; width: 180px; height: 180px; object-fit: cover; border-radius: 24px; border: 6px solid #ffffff; outline: 2px solid #2563eb; box-shadow: 0 20px 25px rgba(15, 23, 42, 0.1);">
              </div>
              <div class="story-content" style="flex: 1.2; min-width: 300px;">
                  <span class="sub-kicker" style="color: #2563eb; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem;">Our Heritage</span>
                  <h2 class="section-title" style="font-family: 'Outfit', sans-serif; font-size: clamp(1.8rem, 4vw, 2.5rem); color: #0f172a; font-weight: 700; margin-bottom: 20px;">A City Shaped by History and Resilience</h2>
                  <div class="story-text" style="font-size: 1.1rem; line-height: 1.8; color: #475569;">
                      <p style="margin-bottom: 15px;">Founded in 1510 by Rao Hamirji, Bhuj has endured as the historic capital of the princely state of Kutch. The city's name originates from its location at the foot of Bhujia Hill, a natural formation that local legend likens to the coiled serpent "Bhujang".</p>
                      <p>Through centuries of trade and royalty, Bhuj developed a unique identity that blends Rajputana splendor with Islamic architecture. Despite the devastating earthquake of 2001, the city has transformed itself into a beacon of resilience, preserving its ancient soul while embracing modern prosperity.</p>
                  </div>
              </div>
           </section>

           <!-- Attractions Bento Grid -->
           <section id="about-bhuj-attractions" class="section-padding" style="padding: 60px 0;">
              <div class="section-heading-block" style="text-align: center; margin-bottom: 50px;">
                  <span class="sub-kicker" style="color: #2563eb; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.1em; display: block; margin-bottom: 8px;">Explore & Discover</span>
                  <h2 class="section-title" style="font-family: 'Outfit', sans-serif; font-size: clamp(1.8rem, 4vw, 2.5rem); color: #0f172a; font-weight: 700; margin: 0;">The Treasures of Bhuj</h2>
                  <p style="color: #64748b; margin-top: 10px; font-size: 1.05rem;">From glass palaces to sacred temples, explore the landmarks that define our skyline.</p>
              </div>

              <div class="bento-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 40px;">
                  <!-- Aina Mahal -->
                  <div class="bento-item" style="position: relative; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; overflow: hidden; box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05); min-height: 240px;">
                      <img loading="lazy" src="/assets/public/images/about-bhuj/aina.webp" alt="Aina Mahal" class="bento-img" style="width: 100%; height: 100%; object-fit: cover;">
                      <div class="bento-overlay" style="position: absolute; bottom: 0; left: 0; width: 100%; padding: 20px; background: linear-gradient(to top, rgba(15,23,42,0.95), rgba(15,23,42,0)); color: #fff;">
                          <span class="bento-tag" style="font-size: 0.7rem; text-transform: uppercase; background: #2563eb; color: #ffffff; font-weight: 700; padding: 4px 8px; border-radius: 4px; margin-bottom: 5px; display: inline-block;">Palace</span>
                          <h3 class="bento-title" style="font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 600; margin: 0; color: #ffffff;">Aina & Prag Mahal</h3>
                      </div>
                  </div>

                  <!-- Smritivan -->
                  <div class="bento-item" style="position: relative; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; overflow: hidden; box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05); min-height: 240px;">
                      <img loading="lazy" src="/assets/public/images/about-bhuj/smrtivan.webp" alt="Smritivan" class="bento-img" style="width: 100%; height: 100%; object-fit: cover;">
                      <div class="bento-overlay" style="position: absolute; bottom: 0; left: 0; width: 100%; padding: 20px; background: linear-gradient(to top, rgba(15,23,42,0.95), rgba(15,23,42,0)); color: #fff;">
                          <span class="bento-tag" style="font-size: 0.7rem; text-transform: uppercase; background: #2563eb; color: #ffffff; font-weight: 700; padding: 4px 8px; border-radius: 4px; margin-bottom: 5px; display: inline-block;">Memorial</span>
                          <h3 class="bento-title" style="font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 600; margin: 0; color: #ffffff;">Smritivan Earthquake Memorial</h3>
                      </div>
                  </div>

                  <!-- Swaminarayan -->
                  <div class="bento-item" style="position: relative; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; overflow: hidden; box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05); min-height: 240px;">
                      <img loading="lazy" src="/assets/public/images/about-bhuj/swaminarayan.webp" alt="Swaminarayan Temple" class="bento-img" style="width: 100%; height: 100%; object-fit: cover;">
                      <div class="bento-overlay" style="position: absolute; bottom: 0; left: 0; width: 100%; padding: 20px; background: linear-gradient(to top, rgba(15,23,42,0.95), rgba(15,23,42,0)); color: #fff;">
                          <span class="bento-tag" style="font-size: 0.7rem; text-transform: uppercase; background: #2563eb; color: #ffffff; font-weight: 700; padding: 4px 8px; border-radius: 4px; margin-bottom: 5px; display: inline-block;">Spiritual</span>
                          <h3 class="bento-title" style="font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 600; margin: 0; color: #ffffff;">Swaminarayan Temple</h3>
                      </div>
                  </div>

                  <!-- Museum -->
                  <div class="bento-item" style="position: relative; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; overflow: hidden; box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05); min-height: 240px;">
                      <img loading="lazy" src="/assets/public/images/about-bhuj/kutch museum1.webp" alt="Museum" class="bento-img" style="width: 100%; height: 100%; object-fit: cover;">
                      <div class="bento-overlay" style="position: absolute; bottom: 0; left: 0; width: 100%; padding: 20px; background: linear-gradient(to top, rgba(15,23,42,0.95), rgba(15,23,42,0)); color: #fff;">
                          <span class="bento-tag" style="font-size: 0.7rem; text-transform: uppercase; background: #2563eb; color: #ffffff; font-weight: 700; padding: 4px 8px; border-radius: 4px; margin-bottom: 5px; display: inline-block;">History</span>
                          <h3 class="bento-title" style="font-family: 'Outfit', sans-serif; font-size: 1.25rem; font-weight: 600; margin: 0; color: #ffffff;">The Kutch Museum</h3>
                      </div>
                  </div>
              </div>
           </section>

           <!-- Culture & Art Section -->
           <section id="about-bhuj-culture" class="culture-section" style="background-color: #ffffff; border: 1px solid #e2e8f0; color: #0f172a; border-radius: 30px; padding: 60px; margin: 40px 0; position: relative; box-shadow: 0 15px 35px rgba(15, 23, 42, 0.05);">
              <div class="section-heading-block" style="text-align: left; margin-bottom: 40px;">
                  <span class="sub-kicker" style="color: #2563eb; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.1em; display: block; margin-bottom: 8px;">The Soul of Kutch</span>
                  <h2 class="section-title" style="color: #0f172a; font-family: 'Outfit', sans-serif; font-size: 2rem; margin: 0;">A Living Tapestry of Art</h2>
              </div>
              <div class="culture-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px;">
                  <div class="culture-card">
                      <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.4rem; color: #2563eb; margin-bottom: 10px;">Vibrant Handicrafts</h3>
                      <p style="color: #475569; line-height: 1.6;">Bhuj is the gateway to the artisan villages of Kutch, where world-class embroidery, block printing, and weaving have been passed down through generations of craftspeople.</p>
                  </div>
                  <div class="culture-card">
                      <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.4rem; color: #2563eb; margin-bottom: 10px;">Tradition & Festivity</h3>
                      <p style="color: #475569; line-height: 1.6;">From the world-famous Rann Utsav to local fairs, Bhuj pulses with the rhythms of folk music, dance, and the vibrant colors of Kachchhi attire.</p>
                  </div>
                  <div class="culture-card">
                      <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.4rem; color: #2563eb; margin-bottom: 10px;">Incredible Flavors</h3>
                      <p style="color: #475569; line-height: 1.6;">Experience a culinary journey featuring the legendary Kutchi Dabeli, traditional Thalis, and unique sweets that satisfy every palate.</p>
                  </div>
              </div>
           </section>

           <!-- Info Grid: Cuisine & Transport -->
           <section id="about-bhuj-info" class="section-padding" style="padding: 60px 0;">
              <div class="info-cards-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px;">
                  <!-- Cuisine -->
                  <div class="info-card-modern" style="background: #ffffff; border: 1px solid #e2e8f0; padding: 40px; border-radius: 32px; box-shadow: 0 10px 25px rgba(15, 23, 42, 0.05);">
                      <div class="info-icon" style="width: 60px; height: 60px; background: rgba(37, 99, 235, 0.08); color: #2563eb; border: 1px solid rgba(37, 99, 235, 0.2); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 25px;">
                          <span class="material-icons" style="font-size: 2rem;">restaurant</span>
                      </div>
                      <h3 class="section-title" style="font-size: 1.5rem; margin-bottom: 20px; color: #0f172a; font-weight: 700;">Must Try Local Food</h3>
                      <ul style="list-style: none; padding: 0;">
                          <li style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Kutchi Dabeli:</strong> The original spicy slider.</li>
                          <li style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Bajra no Rotlo:</strong> Pearl millet bread.</li>
                          <li style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Meskub & Gulab Pak:</strong> Iconic sweets.</li>
                          <li style="padding: 8px 0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Kutchi Thali:</strong> A wholesome local feast.</li>
                      </ul>
                  </div>

                  <!-- Connectivity -->
                  <div class="info-card-modern" style="background: #ffffff; border: 1px solid #e2e8f0; padding: 40px; border-radius: 32px; box-shadow: 0 10px 25px rgba(15, 23, 42, 0.05);">
                      <div class="info-icon" style="width: 60px; height: 60px; background: rgba(37, 99, 235, 0.08); color: #2563eb; border: 1px solid rgba(37, 99, 235, 0.2); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 25px;">
                          <span class="material-icons" style="font-size: 2rem;">flight_takeoff</span>
                      </div>
                      <h3 class="section-title" style="font-size: 1.5rem; margin-bottom: 20px; color: #0f172a; font-weight: 700;">Getting Around</h3>
                      <ul style="list-style: none; padding: 0;">
                          <li style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Bhuj Airport (BHJ):</strong> Daily flights to Mumbai.</li>
                          <li style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Railway Station:</strong> Direct trains to Pune, Mumbai, Delhi.</li>
                          <li style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Inter-city Bus:</strong> Connecting all major Gujarat cities.</li>
                          <li style="padding: 8px 0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Auto & Taxis:</strong> Readily available for city tours.</li>
                      </ul>
                  </div>

                  <!-- Pro Tips -->
                  <div class="info-card-modern" style="background: #ffffff; border: 1px solid #e2e8f0; padding: 40px; border-radius: 32px; box-shadow: 0 10px 25px rgba(15, 23, 42, 0.05);">
                      <div class="info-icon" style="width: 60px; height: 60px; background: rgba(37, 99, 235, 0.08); color: #2563eb; border: 1px solid rgba(37, 99, 235, 0.2); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 25px;">
                          <span class="material-icons" style="font-size: 2rem;">lightbulb</span>
                      </div>
                      <h3 class="section-title" style="font-size: 1.5rem; margin-bottom: 20px; color: #0f172a; font-weight: 700;">Pro Tips for Visitors</h3>
                      <ul style="list-style: none; padding: 0;">
                          <li style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Best Time:</strong> Visit between Nov - Feb.</li>
                          <li style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Shopping:</strong> Shop directly at Bhujodi villages.</li>
                          <li style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Permits:</strong> Needed for White Rann visits.</li>
                          <li style="padding: 8px 0; display: flex; align-items: center; gap: 10px; color: #475569;">✔️ <strong style="color: #0f172a;">Explore:</strong> <a href="https://www.mykutch.org/destinations/bhuj" target="_blank" rel="noopener noreferrer" style="color: #2563eb; font-weight: 600; text-decoration: none;">Know more at MyKutch</a></li>
                      </ul>
                  </div>
              </div>
           </section>

           <!-- External Links Section -->
           <section id="about-bhuj-resources" class="section-padding" style="background: #ffffff; border-radius: 40px; margin: 40px 0; border: 1px solid #e2e8f0; padding: 60px 20px; box-shadow: 0 15px 30px rgba(15, 23, 42, 0.05);">
              <div class="section-heading-block" style="text-align: center; margin-bottom: 30px;">
                  <span class="sub-kicker" style="color: #2563eb; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.1em; display: block; margin-bottom: 8px;">Extended Discovery</span>
                  <h2 class="section-title" style="font-family: 'Outfit', sans-serif; font-size: 1.8rem; font-weight: 700; color: #0f172a;">Know More About Bhuj</h2>
                  <p style="color: #64748b; margin-top: 10px; font-size: 1rem;">Explore detailed guides, destination maps, and travel stories from our trusted travel partners.</p>
              </div>
              <div style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;">
                  <a href="https://www.mykutch.org/destinations/bhuj" target="_blank" rel="noopener noreferrer" class="cta-btn-premium" style="display: inline-block; padding: 12px 28px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; text-decoration: none; border-radius: 100px; font-weight: 700; box-shadow: 0 4px 15px rgba(37, 99, 235, 0.25);">Visit MyKutch.org</a>
                  <a href="https://travelkutch.org/destinations/bhuj/" target="_blank" rel="noopener noreferrer" class="cta-btn-premium" style="display: inline-block; padding: 12px 28px; background: transparent; color: #2563eb; border: 1px solid #2563eb; text-decoration: none; border-radius: 100px; font-weight: 700;">Visit TravelKutch.org</a>
              </div>
           </section>

           <!-- Final CTA -->
           <section id="about-bhuj-help" class="overhaul-cta" style="background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%); border: 1px solid #e2e8f0; border-radius: 40px; padding: 60px; text-align: center; color: #0f172a; margin-top: 60px; box-shadow: 0 15px 35px rgba(37, 99, 235, 0.05);">
              <h2 class="section-title" style="color: #2563eb; font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 800; margin: 0 0 10px 0;">Need any Help in Bhuj?</h2>
              <p style="opacity: 0.9; margin: 0 0 25px 0; color: #475569;">Find the best local service providers, doctors, and businesses directly through our directory.</p>
              <a href="/bhuj/" class="cta-btn-premium" style="display: inline-block; padding: 14px 32px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; text-decoration: none; border-radius: 100px; font-weight: 700; box-shadow: 0 6px 20px rgba(37, 99, 235, 0.25);">Explore Local Services</a>
           </section>

      </div>
  </main>
</BhujLayout>
