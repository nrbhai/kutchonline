---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { PRODUCTS } from '../../data/products';

const electronicsProducts = PRODUCTS.filter(p => p.category === 'electronics');

const techHighlights = [
  {
    title: "Amazon Prime Savings",
    tagline: "Apple M3 & Sony ANC Audio Deals (bhujonline-21)",
    badge: "📦 Amazon Verified",
    image: "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=600&q=80",
    url: "/go/amazon",
    action: "Shop Amazon Tech &rarr;"
  },
  {
    title: "Flipkart Big Billion Electronics",
    tagline: "Samsung Galaxy Flagships & ASUS ROG Gaming Laptops",
    badge: "⚡ Super Deals",
    image: "https://images.unsplash.com/photo-1592899677977-9c10ca588bbd?auto=format&fit=crop&w=600&q=80",
    url: "/go/flipkart",
    action: "Shop Flipkart &rarr;"
  },
  {
    title: "Croma Retail Guarantees",
    tagline: "Zero-Cost EMI & Instant In-Store Pickup Across India",
    badge: "🛡️ Official Warranty",
    image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80",
    url: "/go/croma",
    action: "Explore Croma &rarr;"
  }
];

const subcatPills = [
  { label: "All Tech", filter: "all" },
  { label: "💻 Laptops & Ultrabooks", filter: "Laptops" },
  { label: "📱 Flagship Smartphones", filter: "Smartphones" },
  { label: "🎧 Noise-Canceling Audio", filter: "Headphones & Audio" },
  { label: "🎮 Gaming Laptops", filter: "Gaming" }
];

const techFaqs = [
  {
    question: "How do you track price drops across Amazon, Flipkart, and Croma?",
    answer: "Our automated scrapers record price fluctuations every 15 minutes, tracking bank card instant discounts, exchange bonus incentives, and lightning deals across certified Indian electronics retailers."
  },
  {
    question: "Do you receive free review units that influence hardware recommendations?",
    answer: "No. We evaluate retail devices purchased anonymously through standard e-commerce checkouts to ensure our test units match the exact silicon quality and battery life that paying consumers receive."
  },
  {
    question: "How does the Amazon affiliate link work?",
    answer: "When you click our verified Amazon Prime links (Associates Tag: bhujonline-21), you land directly on the authentic product listing with applicable Prime free delivery and standard manufacturer warranty."
  }
];
---

<BaseLayout
  title="Best Electronics & Tech Deals 2026 | Price Comparison Across Amazon & Flipkart"
  description="Compare lowest prices on laptops, flagship phones, and noise-canceling headphones. Verified specs, lab test comparisons, and price-drop alerts."
>
  <!-- =========================================================================
       1. TECH LAB HERO BANNER
       ========================================================================= -->
  <section class="tech-hero-banner">
    <div class="tech-bg-media">
      <img 
        src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1920&q=85" 
        alt="Cyber Tech Testing Lab Hardware Benchmarks" 
        class="tech-bg-img"
      />
      <div class="tech-hero-overlay"></div>
    </div>

    <div class="container tech-hero-content">
      <div class="breadcrumbs-dark">
        <Breadcrumbs crumbs={[{ label: "Electronics & Tech" }]} />
      </div>

      <div class="tech-badge-row">
        <span class="tech-pill">
          <span class="radar-dot"></span>
          <span>INDEPENDENT HARDWARE BENCHMARKS</span>
        </span>
        <span class="tech-verified-tag">⚡ Multi-Store Live Price Scrapers</span>
      </div>

      <h1 class="tech-hero-title">
        Engineered for Performance.<br />
        <span class="tech-text-gradient">Flagship Laptops, Phones & ANC Audio</span>
      </h1>

      <p class="tech-hero-desc">
        We test sustained thermal throttling, battery runtimes under Docker workloads, and ANC acoustic attenuation. Find the lowest verified prices across Amazon, Flipkart & Croma.
      </p>

      <!-- Store Radar Showcase Grid -->
      <div class="tech-stores-grid">
        {techHighlights.map((t) => (
          <div class="tech-store-card glass-card-dark">
            <div class="store-media">
              <img src={t.image} alt={t.title} class="store-img" />
              <span class="store-badge">{t.badge}</span>
            </div>
            <div class="store-info">
              <h3 class="store-name">{t.title}</h3>
              <p class="store-tagline">{t.tagline}</p>
              <a href={t.url} target="_blank" rel="sponsored nofollow noopener" class="btn btn-affiliate store-btn">
                {t.action}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container main-tech-body">
    <!-- =========================================================================
         2. INTERACTIVE FILTER PILLS
         ========================================================================= -->
    <div class="tech-controls-bar">
      <span class="controls-label">Filter Devices:</span>
      <div class="subcat-pills-row">
        {subcatPills.map((p, i) => (
          <button class={`tech-pill-btn ${i === 0 ? 'active' : ''}`} data-filter={p.filter}>
            {p.label}
          </button>
        ))}
      </div>
    </div>

    <!-- =========================================================================
         3. TESTED HARDWARE PRODUCTS GRID
         ========================================================================= -->
    <div class="tech-grid" id="tech-products-grid">
      {electronicsProducts.map((prod) => (
        <div class="tech-product-item" data-subcat={prod.subcategory}>
          <ProductCard product={prod} />
        </div>
      ))}
    </div>

    <!-- =========================================================================
         4. WIRECUTTER-GRADE BENCHMARK COMPARISON MATRIX
         ========================================================================= -->
    <div class="matrix-wrapper card">
      <ComparisonTable products={electronicsProducts} title="Laboratory Benchmark Comparison Matrix" />
    </div>

    <!-- FAQs -->
    <FAQAccordion faqs={techFaqs} title="Electronics Testing, Warranty & Pricing FAQs" />
  </div>
</BaseLayout>

<script>
  const pillBtns = document.querySelectorAll('.tech-pill-btn');
  const productItems = document.querySelectorAll('.tech-product-item');

  pillBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      pillBtns.forEach(b => b.classList.remove('active'));
      const target = e.currentTarget as HTMLElement;
      target.classList.add('active');
      const filter = target.getAttribute('data-filter') || 'all';

      productItems.forEach((item) => {
        const itemSubcat = item.getAttribute('data-subcat') || '';
        if (filter === 'all' || itemSubcat === filter || (filter === 'Gaming' && itemSubcat.includes('Gaming'))) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  /* =========================================================================
     1. TECH HERO STYLES
     ========================================================================= */
  .tech-hero-banner {
    position: relative;
    padding: clamp(56px, 8vw, 84px) 0 64px;
    color: #ffffff;
    overflow: hidden;
    background: #020617;
  }

  .tech-bg-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .tech-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6) contrast(1.2);
  }

  .tech-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(2, 6, 23, 0.7) 0%, rgba(2, 6, 23, 0.92) 80%, #020617 100%);
  }

  .tech-hero-content {
    position: relative;
    z-index: 1;
    max-width: 1080px;
  }

  .breadcrumbs-dark {
    margin-bottom: 20px;
  }

  .breadcrumbs-dark :global(a),
  .breadcrumbs-dark :global(span) {
    color: rgba(255, 255, 255, 0.75) !important;
  }

  .tech-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .tech-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(2, 132, 199, 0.9);
    color: #ffffff;
    font-size: 0.775rem;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: var(--radius-full);
  }

  .tech-verified-tag {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-size: 0.775rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .tech-hero-title {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .tech-text-gradient {
    background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .tech-hero-desc {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 780px;
  }

  /* Stores Grid */
  .tech-stores-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .tech-store-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    overflow: hidden;
    padding: 14px;
  }

  .store-media {
    position: relative;
    height: 120px;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .store-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .store-badge {
    position: absolute;
    bottom: 8px;
    left: 8px;
    font-size: 0.675rem;
    font-weight: 800;
    padding: 3px 8px;
    background: rgba(15, 23, 42, 0.9);
    color: #ffffff;
    border-radius: var(--radius-full);
  }

  .store-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .store-tagline {
    font-size: 0.775rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.4;
    margin-bottom: 14px;
    flex: 1;
  }

  .store-btn {
    padding: 8px 14px;
    font-size: 0.8rem;
    width: 100%;
    text-align: center;
  }

  /* =========================================================================
     2. MAIN TECH BODY
     ========================================================================= */
  .main-tech-body {
    padding-top: 48px;
    padding-bottom: 64px;
  }

  .tech-controls-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .controls-label {
    font-size: 0.825rem;
    font-weight: 800;
    color: var(--text-subtle);
  }

  .subcat-pills-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tech-pill-btn {
    background: #ffffff;
    border: 1px solid var(--border-default);
    padding: 8px 16px;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    color: var(--text-body);
  }

  .tech-pill-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .tech-pill-btn.active {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 56px;
  }

  .matrix-wrapper {
    padding: clamp(24px, 4vw, 36px);
    margin-bottom: 48px;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .tech-stores-grid {
      grid-template-columns: 1fr;
    }

    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .tech-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
