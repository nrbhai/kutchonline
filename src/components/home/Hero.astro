---
// Hero.astro
---

<section class="hero-sec" id="home">
  <div class="hero-cinema">

    <!-- REAL OCEAN PHOTOGRAPH -->
    <div class="hero-bg-photo" aria-hidden="true"></div>
    <div class="hero-bg-overlay" aria-hidden="true"></div>

    <!-- The wordmark breaking the surface -->
    <div class="hero-wordmark-stage" aria-hidden="true">
      <span class="hero-wordmark-anchor">
        <span class="hero-wordmark-clip">
          <span class="hero-wordmark">KutchOnline</span>
        </span>

        <span class="hero-wordmark-wet-mask">
          <span class="hero-wordmark-wet">KutchOnline</span>
        </span>

        <span class="hero-foam-line"></span>

        <span class="hero-drip hero-drip-1"></span>
        <span class="hero-drip hero-drip-2"></span>
        <span class="hero-drip hero-drip-3"></span>
        <span class="hero-drip hero-drip-4"></span>
        <span class="hero-drip hero-drip-5"></span>
        <span class="hero-drip hero-drip-6"></span>
        <span class="hero-drip hero-drip-7"></span>

        <span class="hero-splash"></span>
        <span class="hero-droplet hero-droplet-1"></span>
        <span class="hero-droplet hero-droplet-2"></span>
        <span class="hero-droplet hero-droplet-3"></span>
        <span class="hero-droplet hero-droplet-4"></span>
        <span class="hero-droplet hero-droplet-5"></span>
        <span class="hero-droplet hero-droplet-6"></span>

        <span class="hero-ripple hero-ripple-a"></span>
        <span class="hero-ripple hero-ripple-b"></span>
        <span class="hero-ripple hero-ripple-c"></span>
      </span>
    </div>

    <!-- FOREGROUND CONTENT -->
    <div class="hero-content">
      <div class="hero-badge-wrap scroll-reveal active">
        <span class="hero-badge-dot"></span>
        <span class="hero-badge-text">Gujarat's Best Kept Secret</span>
      </div>

      <h1 class="hero-title-main scroll-reveal active">
        Explore the <span class="hero-title-italic">Unseen Kutch</span>
      </h1>

      <p class="hero-lead scroll-reveal active">
        Go beyond the White Rann. Discover 40+ hidden gems, forgotten forts, sacred shrines, fossil parks, artisan villages, and secret beaches that most travel guides never mention.
      </p>

      <div class="hero-buttons scroll-reveal active">
        <a href="#hidden" class="btn-gold">
          <span>Explore 40+ Hidden Places</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="#plan" class="btn-stroke">
          <span>Plan My Trip</span>
        </a>
      </div>

      <div class="hero-stats-row scroll-reveal active">
        <div class="hero-stat-block">
          <span class="hero-stat-number">40+</span>
          <span class="hero-stat-title">Hidden Places</span>
        </div>
        <div class="hero-stat-block">
          <span class="hero-stat-number">5</span>
          <span class="hero-stat-title">Regions</span>
        </div>
        <div class="hero-stat-block">
          <span class="hero-stat-number">3500+</span>
          <span class="hero-stat-title">Years of History</span>
        </div>
        <div class="hero-stat-block">
          <span class="hero-stat-number">&#8734;</span>
          <span class="hero-stat-title">Memories</span>
        </div>
      </div>
    </div>

    <div class="hero-scene-badge">Ocean &bull; Desert &bull; Culture</div>

    <a href="#hidden" class="hero-scroll-cue" aria-label="Scroll to explore">
      <span></span>
    </a>
  </div>
</section>
