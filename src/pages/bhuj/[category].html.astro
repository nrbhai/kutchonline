---
import BhujLayout from "../../layouts/BhujLayout.astro";

export async function getStaticPaths() {
  const data = (await import("../../data/data.json")).default;
  const standardPaths = data.map((cat) => {
    return {
      params: { category: `${cat.id}-in-bhuj` },
      props: {
        categoryData: cat,
        allCategories: data,
        categorySlug: `${cat.id}-in-bhuj`
      }
    };
  });

  const LONG_TAIL_PAGES = [
    {
        name: 'Wedding Choreographer',
        slug: 'wedding-choreographer',
        primary_id: 'choreographers-dance',
        hero_icon: 'celebration'
    },
    {
        name: 'Sangeet Choreographer',
        slug: 'sangeet-choreographer',
        primary_id: 'choreographers-dance',
        hero_icon: 'music_note'
    },
    {
        name: 'Dance Classes',
        slug: 'dance-classes',
        primary_id: 'choreographers-dance',
        hero_icon: 'self_improvement'
    }
  ];

  const longTailPaths = LONG_TAIL_PAGES.map((page) => {
    const primaryCat = data.find(c => c.id === page.primary_id) || { providers: [], gu_name: '' };
    return {
      params: { category: `${page.slug}-in-bhuj` },
      props: {
        categoryData: {
          ...primaryCat,
          id: page.slug,
          name: page.name,
          icon: page.hero_icon,
          gu_name: page.name
        },
        allCategories: data,
        categorySlug: `${page.slug}-in-bhuj`
      }
    };
  });

  return [...standardPaths, ...longTailPaths];
}

const { categoryData, allCategories, categorySlug } = Astro.props;

// 3D emoji (Microsoft Fluent Emoji 3D): filename = unicode codepoints joined by "-"
const icon3d = (e: string) =>
  `https://cdn.jsdelivr.net/npm/@lobehub/fluent-emoji-3d@1.1.0/assets/${Array.from(e).map(c => c.codePointAt(0)!.toString(16).padStart(4, '0')).join('-')}.webp`;
const searchIndex = (allCategories as any[])
  .filter((c) => c.providers && c.providers.length)
  .map((c) => ({ id: c.id, name: c.name, gu: c.gu_name || '', icon: c.icon && c.icon !== '❓' ? c.icon : '📌' }))
  .sort((x, y) => x.name.localeCompare(y.name));
const iconImg = (e: string, size: number) =>
  `<img src="${icon3d(e)}" alt="" width="${size}" height="${size}" decoding="async" onerror="this.replaceWith(document.createTextNode(this.dataset.fb))" data-fb="${e}">`;
const category = categorySlug;

const providers = categoryData.providers || [];

const isTruthy = (value: unknown) => {
  if (typeof value === 'boolean') return value;
  if (typeof value === 'number') return value === 1;
  const text = String(value || '').toLowerCase().trim();
  return text === 'yes' || text === 'true' || text === '1';
};

type Provider = {
  name: string; phone: string; area: string; address: string;
  place_id: string; webpage: string; badge: string;
  verified: string; top_rated: string;
  tags: string[];
  [key: string]: unknown;
};

const sortedProviders = [...providers].sort((a: Provider, b: Provider) => {
  const aVerified = isTruthy(a.verified);
  const aTopRated = isTruthy(a.top_rated);
  const bVerified = isTruthy(b.verified);
  const bTopRated = isTruthy(b.top_rated);

  const aTier1 = aVerified && aTopRated;
  const bTier1 = bVerified && bTopRated;
  if (aTier1 && !bTier1) return -1;
  if (!aTier1 && bTier1) return 1;
  if (aVerified && !bVerified) return -1;
  if (!aVerified && bVerified) return 1;
  return 0;
});

const getRelatedCategories = (categoryName: string, allCats: typeof allCategories) => {
  const RELATED_GROUPS = {
    'home_services': ['Electrician', 'Plumber', 'Carpenter / Furniture', 'Masons / Kadia', 'Pest Control', 'Tank Cleaning', 'AC & Fridge Repair', 'Interior Designer', 'Modular Kitchen', 'POP/False Ceiling', 'Tiles Fitter', 'Tiles & Sanitary'],
    'medical': ['Hospitals', 'Doctors MBBS', 'Doctors MD Physician', 'Dentist', 'Ayurvedic Doctors', 'Homeopathy Doctors', 'Physiotherapists', 'Nurses', 'Laboratory', 'Medical store', 'Ambulance', 'Nutritionists/Dieticians'],
    'business_services': ['CA', 'Accounting Services', 'GST/Accounting Services', 'Financial Advisor', 'Insurance Agent', 'Insurance Companies', 'Mutual Fund Advisors', 'Share Brokers / Stock Market', 'Tax Consultant', 'Notary', 'Advocate / Lawyer'],
    'tech_services': ['Computer Sales & Repair', 'Laptop Repairs', 'CCTV Installation', 'Digital Marketing', 'Website Designers', 'Graphic Designers', 'Software Developers', 'Printer Repairs', 'Mobile Repairing'],
    'construction': ['Civil Contractor', 'Civil Engineers', 'Construction Material', 'Aluminium Fabrication', 'Hardware Stores', 'Interior Designer', 'Modular Kitchen', 'Tiles & Sanitary'],
    'events': ['Photographers / Videographers', 'Decorators', 'Event Planners', 'Caterers', 'Flower Shops', 'Tent & Sound System', 'Bridal Wear', 'Choreographers'],
    'vehicles': ['Car Mechanic', 'Bike & Car Rentals', 'Taxi', 'Tours & Travels', 'Transport / Tempo Services', 'Tyre/Puncture Shop', 'EV Dealers', 'RTO Agent', 'Car Driving School', 'Motor Driving School'],
    'food': ['Restaurants', 'Caterers', 'Bakery', 'Sweet shop / Mithai', 'Cafes Tea & Coffee', 'Cold Storage', 'Kirana Stores', 'Milk Delivery'],
    'education': ['Coaching classes', 'Tuition Classes', 'Schools', 'Computer Classes', 'Teachers', 'JEE-NEET Coaching', 'Guitar Teacher'],
    'real_estate': ['Estate Agent', 'Builders - Developers', 'Civil Contractor', 'Civil Engineers', 'Interior Designer', 'Construction Material'],
    'personal_care': ['Hair Stylist ( M / F )', 'Fashion Designer', 'Cloths Merchant', 'Bridal Wear', 'Tattoo Shop', 'Tailor'],
    'travel': ['Hotels', 'Homestays', 'Tours & Travels', 'Taxi', 'Bike & Car Rentals', 'Trekking - Adventure Tours'],
  };

  const related = new Set();
  for (const [, group_cats] of Object.entries(RELATED_GROUPS)) {
    if (group_cats.includes(categoryName)) {
      for (const cat of group_cats) {
        if (cat !== categoryName && allCats.some(c => c.name === cat)) {
          related.add(cat);
        }
      }
    }
  }

  let relatedList = Array.from(related);
  if (relatedList.length > 6) relatedList = relatedList.slice(0, 6);
  if (relatedList.length === 0) {
    relatedList = allCats.filter(c => c.name !== categoryName).slice(0, 6).map(c => c.name);
  }
  return relatedList.map(name => allCats.find(c => c.name === name)).filter(Boolean);
};

const relatedCats = getRelatedCategories(categoryData.name, allCategories);

const title = `Best ${categoryData.name} in Bhuj (2026) – Contact Numbers, Verified Listings | bhuj.kutchonline.com`;
const description = `Find verified ${categoryData.name} in Bhuj with contact numbers, ratings, and addresses. Search top-rated local ${categoryData.name.toLowerCase()} serving Madhapar, Sanskar Nagar, and surrounding areas.`;

const buildKeywords = (name: string) => {
  const base = name.toLowerCase().trim();
  return [`${base} in bhuj`, `${base} near me`, `best ${base} near me`, `top ${base} near me`, `verified ${base} near me`, `${base} bhuj`, `best ${base} bhuj`, `${base} bhuj contact number`, `${base} in bhuj kutch`, `${base} bhuj gujarat`].join(', ');
};

const keywords = buildKeywords(categoryData.name);
const canonicalPath = `${category}.html`;

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "serviceType": categoryData.name,
      "provider": { "@type": "LocalBusiness", "name": "bhuj.kutchonline.com", "url": "https://bhuj.kutchonline.com" },
      "areaServed": { "@type": "City", "name": "Bhuj" },
      "hasOfferCatalog": { "@type": "OfferCatalog", "name": `${categoryData.name} in Bhuj`, "itemListElement": [{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": `Verified ${categoryData.name} Services` } }] }
    },
    {
      "@type": "LocalBusiness",
      "name": `${categoryData.name} in Bhuj`,
      "description": `Find verified ${categoryData.name.toLowerCase()} in Bhuj, Kutch, Gujarat.`,
      "url": `https://bhuj.kutchonline.com/${canonicalPath}`,
      "telephone": "+91-9825034580",
      "email": "contact@kutchonline.com",
      "address": { "@type": "PostalAddress", "addressLocality": "Bhuj", "addressRegion": "Gujarat", "addressCountry": "IN", "postalCode": "370001" },
      "geo": { "@type": "GeoCoordinates", "latitude": "23.2420", "longitude": "69.6669" },
      "areaServed": { "@type": "City", "name": "Bhuj" },
      "priceRange": "$$"
    },
    ...(providers.length ? [{
      "@type": "ItemList",
      "name": `${categoryData.name} in Bhuj`,
      "numberOfItems": providers.length,
      "itemListElement": sortedProviders.slice(0, 20).map((p: any, i: number) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "LocalBusiness",
          "name": p.name,
          ...(p.phone ? { "telephone": `+91${String(p.phone).replace(/\D/g, '').slice(-10)}` } : {}),
          "address": { "@type": "PostalAddress", "streetAddress": p.address || undefined, "addressLocality": p.area || "Bhuj", "addressRegion": "Gujarat", "addressCountry": "IN" },
          ...(p.webpage ? { "url": p.webpage } : {}),
        },
      })),
    }] : []),
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://bhuj.kutchonline.com/" },
        { "@type": "ListItem", "position": 2, "name": `${categoryData.name} in Bhuj`, "item": `https://bhuj.kutchonline.com/${canonicalPath}` }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": `How to find the best ${categoryData.name} in Bhuj?`, "acceptedAnswer": { "@type": "Answer", "text": `bhuj.kutchonline.com provides a verified list of ${categoryData.name.toLowerCase()} in Bhuj with contact numbers and ratings. Look for providers with Verified and Top Rated badges.` } },
        { "@type": "Question", "name": `Are these ${categoryData.name} verified?`, "acceptedAnswer": { "@type": "Answer", "text": `Yes, many ${categoryData.name.toLowerCase()} on bhuj.kutchonline.com are verified. We check contact details and business information.` } },
        { "@type": "Question", "name": `What areas do these ${categoryData.name} serve?`, "acceptedAnswer": { "@type": "Answer", "text": `The ${categoryData.name.toLowerCase()} listed here primarily serve Bhuj city and surrounding areas in Kutch district, Gujarat.` } }
      ]
    }
  ]
});

const formatPhoneForWA = (phone: string) => {
  const clean = phone.replace(/\D/g, '');
  return clean.length === 10 ? `91${clean}` : clean;
};

const getInitial = (name: string) => name ? name.trim()[0].toUpperCase() : '?';

const AVATAR_COLORS = [
  ['#dbeafe','#1d4ed8'], ['#dcfce7','#15803d'], ['#fef9c3','#a16207'],
  ['#fce7f3','#9d174d'], ['#ede9fe','#6d28d9'], ['#ffedd5','#c2410c'],
  ['#e0f2fe','#0369a1'], ['#f0fdf4','#166534'],
];
const getAvatarColor = (name: string) => AVATAR_COLORS[(name?.charCodeAt(0) || 0) % AVATAR_COLORS.length];
---

<BhujLayout
  title={title}
  description={description}
  keywords={keywords}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
  bodyClass="page-category"
  robots={providers.length ? undefined : "noindex, follow"}
>
  <main class="cat-page">

    <!-- ── HERO ─────────────────────────────────────── -->
    <section class="cat-hero">
      <div class="cat-hero-pattern" aria-hidden="true"></div>
      <div class="cat-hero-inner">
        <div class="cat-hero-content">
          <nav class="cat-breadcrumb" aria-label="Breadcrumb">
            <a href="/bhuj/" class="crumb-link">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
              Home
            </a>
            <svg class="crumb-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
            <span class="crumb-current">{categoryData.name}</span>
          </nav>

          <div class="cat-hero-title-row">
            <div class="cat-hero-icon-stamp" aria-hidden="true">
              <span class="stamp-icon" set:html={/^[\x00-\x7f]+$/.test(categoryData.icon || '') ? iconImg('📌', 50) : iconImg(categoryData.icon && categoryData.icon !== "❓" ? categoryData.icon : "📌", 50)}></span>
            </div>
            <div class="cat-hero-title-wrap">
              <h1 class="cat-hero-h1">
                <span class="cat-hero-name">{categoryData.name}</span>
                <span class="cat-hero-city-mark">in Bhuj</span>
              </h1>
              {categoryData.gu_name && categoryData.gu_name !== categoryData.name && (
                <p class="cat-hero-gu">{categoryData.gu_name} · ભુજ</p>
              )}
            </div>
          </div>

          <div class="cat-hero-meta">
            <span class="cat-count-pill" id="results-count">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {providers.length} provider{providers.length === 1 ? '' : 's'}
            </span>
            <span class="cat-meta-free">✓ Free to contact</span>
          </div>

          <div class="cat-search-wrap" id="site-search">
            <div class="cat-search-field">
              <svg class="cat-search-ico" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input
                type="search"
                id="site-search-input"
                class="cat-search-input"
                placeholder="Search any service… (Electrician, Doctor, Taxi…)"
                autocomplete="off"
                role="combobox"
                aria-expanded="false"
                aria-controls="site-search-results"
                aria-label="Search all services in Bhuj"
              />
              <button class="cat-search-clear" id="site-search-clear" type="button" aria-label="Clear search" hidden>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
            <ul class="cs-results" id="site-search-results" role="listbox" hidden></ul>
          </div>
        </div>
      <aside class="hero-offers" aria-label="Offers for businesses">
        <a href="/bhuj/offers" class="offer-row"><span class="offer-name">Get Verified</span><span class="offer-sep">:</span><span class="offer-price">899</span></a>
        <a href="/bhuj/offers" class="offer-row"><span class="offer-name">Top Rated + Webpage</span><span class="offer-sep">:</span><span class="offer-price">1999</span></a>
      </aside>
      </div>
    </section>

    <!-- ── PROVIDER LIST ─────────────────────────────── -->
    <div class="cat-body">

      {providers.length === 0 ? (
        <div class="cat-empty">
          <span class="cat-empty-stamp" aria-hidden="true">Coming Soon</span>
          <div class="cat-empty-icon">🔍</div>
          <h2 class="cat-empty-h">Coming Soon</h2>
          <p class="cat-empty-p">We're collecting verified {categoryData.name.toLowerCase()} in Bhuj. Check back soon!</p>
          <a href="/bhuj/" class="cat-empty-back">← Back to all categories</a>
        </div>
      ) : (
        <ul class="provider-list" id="provider-list" role="list">
          {sortedProviders.map((pRaw, index) => {
            const p = pRaw as Provider;
            const isV = isTruthy(p.verified);
            const isTR = isTruthy(p.top_rated);
            const cleanPhone = formatPhoneForWA(p.phone || '');
            const mapsUrl = p.place_id
              ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(p.name + ' ' + (p.area || 'Bhuj') + ' Bhuj')}&query_place_id=${p.place_id}`
              : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(p.name + ' ' + (p.area || 'Bhuj') + ' Bhuj Kutch Gujarat India')}`;
            const [avatarBg, avatarColor] = getAvatarColor(p.name || '');

            let tier = '';
            if (isV && isTR) tier = 'tier-elite';
            else if (isTR) tier = 'tier-top';
            else if (isV) tier = 'tier-verified';

            const isFeatured = index === 0 && sortedProviders.length > 3 && (isV || isTR);

            return (
              <>
                <li class={`pcard ${tier} ${isFeatured ? 'pcard-featured' : ''}`} data-name={p.name?.toLowerCase()} data-area={p.area?.toLowerCase()} data-phone={p.phone}>

                  {isFeatured && <span class="pcard-ribbon">Featured</span>}

                  <div class="pcard-top">
                    {/* Avatar */}
                    <div class="pcard-avatar" style={`background:${avatarBg};color:${avatarColor}`} aria-hidden="true">
                      {getInitial(p.name)}
                    </div>

                    {/* Info */}
                    <div class="pcard-info">
                      <div class="pcard-name-row">
                        <span class="pcard-name">{p.name}</span>
                        <div class="pcard-badges">
                          {isV && isTR && (
                            <span class="pbadge pbadge-elite">
                              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                              Trusted
                            </span>
                          )}
                          {isV && (
                            <span class="pbadge pbadge-verified">
                              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                              Verified
                            </span>
                          )}
                          {isTR && !isV && (
                            <span class="pbadge pbadge-top">
                              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                              Top Rated
                            </span>
                          )}
                          {p.badge && <span class="pbadge pbadge-custom">{p.badge}</span>}
                        </div>
                      </div>

                      <div class="pcard-meta-row">
                        <span class="pcard-area">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                          {p.area || 'Bhuj'}
                        </span>
                        {p.tags && p.tags.length > 0 && p.tags.slice(0, 2).map(t => (
                          <span class="pcard-tag">{t}</span>
                        ))}
                      </div>

                      {p.address && (
                        <p class="pcard-address">
                          {p.address}
                        </p>
                      )}
                    </div>
                  </div>

                  {/* Phone + Primary CTA */}
                  <div class="pcard-phone-row">
                    <a href={`tel:${p.phone}`} class="pcard-phone-link" aria-label={`Call ${p.name}`}>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.01 1.18 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"></path></svg>
                      {p.phone}
                    </a>
                    <a href={`tel:${p.phone}`} class="pcard-call-btn" aria-label={`Call ${p.name}`}>
                      Call Now
                    </a>
                  </div>

                  {/* Secondary actions */}
                  <div class="pcard-actions">
                    <a href={`https://wa.me/${cleanPhone}`} target="_blank" rel="noopener noreferrer" class="paction paction-wa">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path><path d="M11.999 2C6.479 2 2 6.479 2 12c0 1.883.522 3.641 1.425 5.146L2 22l4.984-1.311A9.953 9.953 0 0012 22c5.521 0 10-4.479 10-10S17.521 2 11.999 2zm.001 18.182a8.175 8.175 0 01-4.17-1.143l-.298-.177-3.091.812.825-3.013-.196-.309A8.167 8.167 0 013.818 12c0-4.512 3.67-8.182 8.182-8.182 4.513 0 8.182 3.67 8.182 8.182 0 4.513-3.669 8.182-8.182 8.182z"></path></svg>
                      WhatsApp
                    </a>

                    <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="paction paction-maps">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                      Maps
                    </a>

                    {p.webpage ? (
                      <a href={p.webpage} target="_blank" rel="noopener noreferrer" class="paction paction-web">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path></svg>
                        Website
                      </a>
                    ) : (
                      <button class="paction paction-disabled" disabled aria-disabled="true">
