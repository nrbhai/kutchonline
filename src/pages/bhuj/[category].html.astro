<script is:inline>
(function () {
  const input = document.getElementById('search-input');
  const clearBtn = document.getElementById('search-clear');
  const list = document.getElementById('provider-list');
  const noResult = document.getElementById('no-result');
  const countPill = document.getElementById('results-count');

  if (!input || !list) return;

  const cards = Array.from(list.querySelectorAll('li.pcard'));
  const totalCount = cards.length;

  function filter(q) {
    const term = q.toLowerCase().trim();
    let visible = 0;

    cards.forEach(card => {
      const name = (card.dataset.name || '');
      const area = (card.dataset.area || '');
      const phone = (card.dataset.phone || '');
      const match = !term || name.includes(term) || area.includes(term) || phone.includes(term);
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    // hide/show promo row based on any card being visible
    list.querySelectorAll('li.promo-row').forEach(row => {
      row.style.display = term ? 'none' : '';
    });

    if (noResult) noResult.hidden = visible > 0;
    if (countPill) countPill.textContent = term
      ? `${visible} of ${totalCount} providers`
      : `${totalCount} provider${totalCount === 1 ? '' : 's'}`;

    if (clearBtn) clearBtn.hidden = !term;
  }

  input.addEventListener('input', () => filter(input.value));
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      input.value = '';
      filter('');
      input.focus();
    });
  }
})();
</script>

