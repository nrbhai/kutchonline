}

interface Props {
  route: {
    slug: string;
    storeName: string;
    destinationUrl: string;
  };
}

const { route } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Redirecting to {route.storeName} - BhujDeals Verified Gateway</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #f8fafc;
      font-family: 'Inter', system-ui, sans-serif;
      color: #0f172a;
      padding: 20px;
      text-align: center;
    }
    .redirect-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 40px 32px;
      max-width: 480px;
      width: 100%;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
    }
    .spinner-ring {
      width: 48px;
      height: 48px;
      border: 4px solid #e2e8f0;
      border-top-color: #0284c7;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 20px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    h1 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.35rem;
      font-weight: 800;
      margin-bottom: 8px;
    }
    p {
      color: #64748b;
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 24px;
    }
    .badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      background: #dcfce7;
      color: #166534;
      padding: 4px 10px;
      border-radius: 9999px;
      margin-bottom: 16px;
    }
    .direct-link {
      color: #0284c7;
      font-weight: 600;
      font-size: 0.85rem;
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="redirect-card">
    <div class="spinner-ring"></div>
    <span class="badge">🔒 Verified Official Partner Store</span>
    <h1>Taking You Directly to {route.storeName}...</h1>
    <p>Activating lowest price guarantee and verified promotional discounts. You will be redirected automatically to {route.storeName} in a moment.</p>
    <a href={route.destinationUrl} id="manual-link" class="direct-link">Click here if not redirected in 3 seconds &rarr;</a>
  </div>

  <script define:vars={{ 
    baseDest: route.destinationUrl, 
    storeSlug: route.slug, 
    amazonTag: AFFILIATE_CONFIG.amazon.tag,
    agodaCityUrls: AFFILIATE_CONFIG.agoda.cityUrls
  }}>
    // Dynamic deep linking resolver
    const params = new URLSearchParams(window.location.search);
    const prodId = params.get('id') || '';
    const cleanQuery = prodId.replace(/-/g, ' ');
    const cityParam = (params.get('city') || '').toLowerCase();
    const hotelParam = (params.get('hotel') || '').toLowerCase();

    let target = baseDest;

    // 1. Direct Amazon routing with real Associate Tag bhujonline-21
    if (storeSlug === 'amazon') {
      if (prodId) {
        target = `https://www.amazon.in/s?k=${encodeURIComponent(cleanQuery)}&tag=${amazonTag}`;
      } else {
        target = `https://www.amazon.in/?tag=${amazonTag}`;
      }
    }
    // 2. Agoda & Hotels Routing (User Agoda Partner CID 1970139)
    else if (storeSlug === 'agoda' || storeSlug === 'hotels' || storeSlug === 'booking') {
      if (cityParam && agodaCityUrls && agodaCityUrls[cityParam]) {
        target = agodaCityUrls[cityParam];
      } else if (hotelParam.includes('bhuj') && agodaCityUrls) {
        target = agodaCityUrls.bhuj;
      } else if (hotelParam.includes('dholavira') && agodaCityUrls) {
        target = agodaCityUrls.dholavira;
      } else if ((hotelParam.includes('udaipur') || hotelParam.includes('oberoi')) && agodaCityUrls) {
        target = agodaCityUrls.udaipur;
      } else if ((hotelParam.includes('jaipur') || hotelParam.includes('rambagh')) && agodaCityUrls) {
        target = agodaCityUrls.jaipur;
      } else if ((hotelParam.includes('jaisalmer') || hotelParam.includes('suryagarh')) && agodaCityUrls) {
        target = agodaCityUrls.jaisalmer;
      } else if ((hotelParam.includes('srinagar') || hotelParam.includes('lalit')) && agodaCityUrls) {
        target = agodaCityUrls.srinagar;
      } else {
        target = "https://www.agoda.com/partners/partnersearch.aspx?pcs=1&cid=1970139&hl=en-us";
      }
    }
    // 3. All other merchant & Cuelinks campaign links route directly to baseDest

    // Update manual link href
    const linkEl = document.getElementById('manual-link');
    if (linkEl) linkEl.href = target;

    // Telemetry log
    console.log(`[BHUJDEALS GATEWAY] Routing to ${storeSlug}: ${target}`);

    // Fast redirect
    setTimeout(() => {
      window.location.replace(target);
    }, 350);
  </script>
</body>
</html>
