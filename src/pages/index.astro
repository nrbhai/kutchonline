---
import Layout from "../layouts/Layout.astro";
import Header from "../components/home/Header.astro";
import Hero from "../components/home/Hero.astro";
import IntroStrip from "../components/home/IntroStrip.astro";
import HiddenGems from "../components/home/HiddenGems.astro";
import Popular from "../components/home/Popular.astro";
import Culture from "../components/home/Culture.astro";
import Food from "../components/home/Food.astro";
import Festivals from "../components/home/Festivals.astro";
import Tips from "../components/home/Tips.astro";
import MapSection from "../components/home/MapSection.astro";
import PlannerForm from "../components/home/PlannerForm.astro";
import Footer from "../components/home/Footer.astro";

import "../styles/home.css";
---

<Layout 
  title="Hidden Kutch Explorer — Offbeat Kutch Travel Guide" 
  theme="kutch" 
  description="Discover 40+ hidden gems, offbeat places, and underrated destinations across Kutch. Your ultimate Kutch tourism guide for culture, heritage, and adventure."
>
  <div class="home-page">
    <Header />
    <Hero />
    <IntroStrip />
    <HiddenGems />
    <Popular />
    <Culture />
    <Food />
    <Festivals />
    <Tips />
    <MapSection />
    <PlannerForm />
    <Footer />
  </div>
</Layout>

<script src="../scripts/home.js"></script>
