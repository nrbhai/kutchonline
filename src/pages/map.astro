  }

  .tip-icon {
    animation: sway 3s infinite ease-in-out;
  }

  .tip-box p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #cbd5e1;
  }

  .card-footer {
    margin-top: 1rem;
  }

  .explore-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background-color: var(--theme-primary);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.9rem;
    cursor: pointer;
