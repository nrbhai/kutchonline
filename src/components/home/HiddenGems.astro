// Helper function to find a matching detailed destination in the compiled JSON
function getDestinationLink(gemName) {
  const normGem = gemName.toLowerCase().replace(/ & /g, ' ').replace(/-/g, ' ').trim();
  const match = destinations.find(d => {
    const normTitle = d.heroTitle.toLowerCase().replace(/—/g, ' ').replace(/-/g, ' ').trim();
    const normSlug = d.slug.toLowerCase().replace(/-/g, ' ').trim();
    return normTitle.includes(normGem) || normGem.includes(normTitle) || normSlug.includes(normGem) || normGem.includes(normSlug);
  });
  return match ? `/explore/${match.slug}/` : null;
}
---

<section class="gems-sec" id="hidden">
  <div class="home-container">
    <div class="section-header-center scroll-reveal">
      <span class="section-label">The Untold Kutch</span>
      <h2 class="section-title-text">40+ Hidden & Underrated Places Across Kutch</h2>
      <div class="section-divider"></div>
      <p class="section-desc-text">These are the places that don't trend on Instagram — yet. Discover Kutch the way locals know it, region by region.</p>
    </div>

    <!-- Region Selector Tabs -->
    <div class="region-tabs-container scroll-reveal">
      {regions.map((region, index) => (
        <button 
          class={`region-tab-btn ${index === 0 ? "active" : ""}`} 
          data-region={region.id}
        >
          <span>{region.icon}</span>
          <span>{region.name}</span>
          <span class="region-tab-count">{region.count}</span>
        </button>
      ))}
    </div>

    <!-- Places Grids -->
    <div class="places-grid-wrap scroll-reveal">
      {regions.map((region, index) => {
        const regionGems = gems.filter(gem => gem.region === region.id);
        return (
          <div 
            class={`region-view-block ${index === 0 ? "active" : ""}`} 
            id={`region-${region.id}`}
          >
            {regionGems.map((gem) => {
              const href = getDestinationLink(gem.name);
              const CardTag = href ? 'a' : 'div';
              const cardProps = href ? { href, class: "place-card-trendy clickable-card" } : { class: "place-card-trendy" };
              
              return (
                <CardTag {...cardProps}>
                  <div class="place-card-banner">
                    <div class="place-card-banner-bg" style={`background: ${gem.gradient}`}></div>
                    <div class="place-card-emoji-wrap">
                      {gem.emoji}
                    </div>
                    <span class="place-card-no">#{String(gem.id).padStart(2, '0')}</span>
                    <span class="place-card-badge">{gem.category}</span>
                  </div>
                  <div class="place-card-body">
                    <h3 class="place-card-title">
                      {gem.name}
                      {href && <span class="card-link-arrow">→</span>}
                    </h3>
                    <p class="place-card-desc">{gem.desc}</p>
                    <div class="place-card-why">
                      <span class="place-card-why-label">
                        ⭐ Why Visit
                      </span>
                      <p class="place-card-why-text">{gem.whyVisit}</p>
                    </div>
                  </div>
                </CardTag>
              );
            })}
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Clickable card elements */
  .clickable-card {
    text-decoration: none;
    cursor: pointer;
  }
  .card-link-arrow {
    margin-left: 0.5rem;
    color: var(--gold-light);
    display: inline-block;
    transition: transform 0.3s ease;
  }
  .clickable-card:hover .card-link-arrow {
    transform: translateX(4px);
  }
</style>

