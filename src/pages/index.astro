---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import HotelCard from "../components/HotelCard.astro";
import CouponCard from "../components/CouponCard.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import Newsletter from "../components/Newsletter.astro";
import { CATEGORIES } from "../data/categories";
import { PRODUCTS } from "../data/products";
import { HOTELS } from "../data/hotels";
import { DEALS } from "../data/deals";
import { BLOG_POSTS } from "../data/blog";

// Subsets for homepage
const electronicsProds = PRODUCTS.filter((p) => p.category === "electronics");
const beautyProds = PRODUCTS.filter((p) => p.category === "beauty");
const trendingProds = PRODUCTS.filter((p) => p.featured);
const topHotels = HOTELS.slice(0, 3);
const flashDeals = DEALS.slice(0, 4);
---

<BaseLayout
  title="BhujDeals - Discover, Compare & Save on Products & Stays"
  description="India's trusted shopping discovery radar. Compare live prices across Amazon, Agoda, AJIO, Flipkart, Nykaa & Croma with verified lowest price guarantees."
>
  <!-- =========================================================================
       1. 2026 ULTRA-MODERN GRAPHICAL HERO SECTION
       ========================================================================= -->
  <section class="hero-section">
    <!-- Ambient Glow Orbs -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="ambient-glow glow-3"></div>
    <div class="hero-grid-pattern"></div>

    <div class="container hero-container">
      <div class="hero-split-grid">
        <!-- Hero Left: Content & Conversion Controls -->
        <div class="hero-content">
          <div class="hero-badge-wrap">
            <span class="live-radar-badge glass-panel">
              <span class="radar-dot"></span>
              <span class="radar-text"
                >LIVE DEALS RADAR: 2,840+ ACTIVE PRICE DROPS</span
              >
            </span>
            <span class="hero-stat-pill">⚡ Over ₹2.8 Cr Saved</span>
          </div>

          <h1 class="hero-headline">
            Stop Overpaying.<br />
            Compare Live Prices Across <span class="text-gradient-brand"
              >Amazon, Agoda, AJIO & Flipkart</span
            >
          </h1>

          <p class="hero-subtitle">
            Independent lab benchmarks, instant coupon audits, and verified
            Agoda hotel room tariffs. Find the guaranteed lowest price in
            seconds.
          </p>

          <!-- Interactive Search & Filter Box -->
          <div class="hero-search-box glass-panel">
            <div class="search-input-group">
              <span class="search-icon">🔍</span>
              <input
                type="text"
                id="hero-search-input"
                placeholder="Search MacBook, Agoda Bhuj Hotels, AJIO Hoodies, Nykaa Serums..."
                autocomplete="off"
              />
            </div>
            <a href="/deals" class="btn btn-affiliate search-submit-btn">
              Explore Deals &rarr;
            </a>
          </div>

          <!-- Quick Category Tags -->
          <div class="hero-quick-tags">
            <span class="quick-label">POPULAR:</span>
            <a href="/hotels" class="hero-tag">🏨 Agoda Stays</a>
            <a href="/fashion" class="hero-tag">👗 AJIO 70% Off</a>
            <a href="/electronics" class="hero-tag">💻 MacBook M3</a>
            <a href="/beauty" class="hero-tag">✨ K-Beauty Nykaa</a>
            <a href="/travel" class="hero-tag">✈️ Cheap Flights</a>
          </div>

          <!-- Trust Proof Metrics -->
          <div class="hero-proof-row">
            <div class="proof-item">
              <span class="proof-num">100%</span>
              <span class="proof-label">Unbiased Testing</span>
            </div>
            <div class="proof-divider"></div>
            <div class="proof-item">
              <span class="proof-num">Agoda & Amazon</span>
              <span class="proof-label">Official Partner Tracking</span>
            </div>
            <div class="proof-divider"></div>
            <div class="proof-item">
              <span class="proof-num">₹0 Extra</span>
              <span class="proof-label">Always Free to Use</span>
            </div>
          </div>
        </div>

        <!-- Hero Right: 3D Floating Interactive Visual Deal Showcase -->
        <div class="hero-visual-showcase">
          <!-- Floating Deal Card 1: Agoda Heritage Stays (Top) -->
          <div class="floating-card float-card-1 glass-panel animate-float-1">
            <div class="card-media-wrap">
              <img
                src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80"
                alt="Agoda Udaipur Lake Pichola Resort"
                class="card-thumb"
              />
              <span class="card-network-chip agoda-chip"
                >🏨 Agoda Partner (CID 1970139)</span
              >
              <span class="card-score-chip">★ 9.8 Superb</span>
            </div>
            <div class="card-details">
              <div class="card-meta">Udaipur & Bhuj Heritage Escapes</div>
              <h4 class="card-title">The Oberoi Udaivilas, Lake Pichola</h4>
              <div class="card-price-row">
                <div class="price-group">
                  <span class="price-current">₹42,500</span>
                  <span class="price-old">₹55,000</span>
                </div>
                <a
                  href="/go/agoda?city=udaipur"
                  target="_blank"
                  rel="sponsored nofollow noopener"
                  class="btn btn-affiliate btn-xs"
                >
                  Book Agoda &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- Floating Deal Card 2: AJIO Streetwear (Middle Right) -->
          <div class="floating-card float-card-2 glass-panel animate-float-2">
            <div class="card-media-wrap">
              <img
                src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&w=600&q=80"
                alt="AJIO Trendsetter Heavyweight Hoodie"
                class="card-thumb"
              />
              <span class="card-network-chip ajio-chip">🛍️ AJIO Exclusive</span>
              <span class="card-discount-chip">🔥 70% OFF</span>
            </div>
            <div class="card-details">
              <div class="card-meta">Streetwear & Hoodies</div>
              <h4 class="card-title">AJIO 450 GSM Oversized Fleece Hoodie</h4>
              <div class="card-price-row">
                <div class="price-group">
                  <span class="price-current">₹1,199</span>
                  <span class="price-old">₹2,499</span>
                </div>
                <a
                  href="/go/ajio"
                  target="_blank"
                  rel="sponsored nofollow noopener"
                  class="btn btn-affiliate btn-xs"
                >
                  Shop AJIO &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- Floating Deal Card 3: MacBook Air M3 (Bottom Left) -->
          <div class="floating-card float-card-3 glass-panel animate-float-3">
            <div class="card-media-wrap">
              <img
                src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=600&q=80"
                alt="Apple MacBook Air M3 on Amazon"
                class="card-thumb"
              />
              <span class="card-network-chip amazon-chip"
                >📦 Amazon Associates</span
              >
              <span class="card-shoppers-chip">👥 42 Viewing</span>
            </div>
            <div class="card-details">
              <div class="card-meta">Laptops & Workstations</div>
              <h4 class="card-title">Apple MacBook Air 15-inch M3</h4>
              <div class="card-price-row">
                <div class="price-group">
                  <span class="price-current">₹1,34,900</span>
                  <span class="price-old">₹1,54,900</span>
                </div>
                <a
                  href="/go/amazon?id=apple-macbook-air-m3"
                  target="_blank"
                  rel="sponsored nofollow noopener"
                  class="btn btn-affiliate btn-xs"
                >
                  Amazon Prime &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LIVE DEAL ALERT STRIP -->
  <div
    class="deal-alert-strip"
    role="marquee"
    aria-label="Live price drop alerts"
  >
    <div class="alert-strip-inner">
      <span class="alert-label">📉 PRICE DROPS</span>
      <div class="alert-ticker-wrap">
        <div class="alert-ticker">
          <!-- Set 1 -->
          <span class="ticker-item"
            ><span class="ticker-store">Amazon</span> Apple AirPods Pro 2 — <span
              class="ticker-price">₹19,990</span
            >
            <span class="ticker-drop">↓ ₹4,010 off</span></span
          >
          <span class="ticker-sep">•</span>
          <span class="ticker-item"
            ><span class="ticker-store">Nykaa</span> Minimalist 10% Niacinamide —
            <span class="ticker-price">₹399</span>
            <span class="ticker-drop">↓ 30% off</span></span
          >
          <span class="ticker-sep">•</span>
          <span class="ticker-item"
            ><span class="ticker-store">Agoda</span> Taj Lake Palace Udaipur — <span
              class="ticker-price">₹28,500/nt</span
            >
            <span class="ticker-drop">↓ ₹6,500 off</span></span
          >
          <span class="ticker-sep">•</span>
          <span class="ticker-item"
            ><span class="ticker-store">Flipkart</span> Samsung Galaxy S25 — <span
              class="ticker-price">₹74,999</span
            >
            <span class="ticker-drop">↓ ₹12,000 off</span></span
          >
          <span class="ticker-sep">•</span>
          <span class="ticker-item"
            ><span class="ticker-store">AJIO</span> Oversized Hoodie 450GSM — <span
              class="ticker-price">₹899</span
            >
            <span class="ticker-drop">↓ 64% off</span></span
          >
          <span class="ticker-sep">•</span>
          <span class="ticker-item"
            ><span class="ticker-store">Croma</span> Sony WH-1000XM5 — <span
              class="ticker-price">₹24,990</span
            >
            <span class="ticker-drop">↓ ₹7,000 off</span></span
          >
          <span class="ticker-sep">•</span>
          <!-- Set 2 (duplicate for seamless loop) -->
          <span class="ticker-item" aria-hidden="true"
            ><span class="ticker-store">Amazon</span> Apple AirPods Pro 2 — <span
              class="ticker-price">₹19,990</span
            >
            <span class="ticker-drop">↓ ₹4,010 off</span></span
          >
          <span class="ticker-sep" aria-hidden="true">•</span>
          <span class="ticker-item" aria-hidden="true"
            ><span class="ticker-store">Nykaa</span> Minimalist 10% Niacinamide —
            <span class="ticker-price">₹399</span>
            <span class="ticker-drop">↓ 30% off</span></span
          >
          <span class="ticker-sep" aria-hidden="true">•</span>
          <span class="ticker-item" aria-hidden="true"
            ><span class="ticker-store">Agoda</span> Taj Lake Palace Udaipur — <span
              class="ticker-price">₹28,500/nt</span
            >
            <span class="ticker-drop">↓ ₹6,500 off</span></span
          >
          <span class="ticker-sep" aria-hidden="true">•</span>
          <span class="ticker-item" aria-hidden="true"
            ><span class="ticker-store">Flipkart</span> Samsung Galaxy S25 — <span
              class="ticker-price">₹74,999</span
            >
            <span class="ticker-drop">↓ ₹12,000 off</span></span
          >
          <span class="ticker-sep" aria-hidden="true">•</span>
          <span class="ticker-item" aria-hidden="true"
            ><span class="ticker-store">AJIO</span> Oversized Hoodie 450GSM — <span
              class="ticker-price">₹899</span
            >
            <span class="ticker-drop">↓ 64% off</span></span
          >
          <span class="ticker-sep" aria-hidden="true">•</span>
          <span class="ticker-item" aria-hidden="true"
            ><span class="ticker-store">Croma</span> Sony WH-1000XM5 — <span
              class="ticker-price">₹24,990</span
            >
            <span class="ticker-drop">↓ ₹7,000 off</span></span
          >
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       2. OFFICIAL PARTNER MERCHANT MARQUEE (CONTINUOUS TICKER)
       ========================================================================= -->
  <section class="partner-marquee-section">
    <div class="marquee-track">
      <div class="marquee-content">
        <a href="/go/agoda" class="partner-chip">
          <span class="dot-live">●</span> Agoda Official Partner (CID 1970139)
        </a>
        <a href="/go/amazon" class="partner-chip">
          <span class="dot-live">●</span> Amazon Associates India (bhujonline-21)
        </a>
        <a href="/go/ajio" class="partner-chip">
          <span class="dot-live">●</span> AJIO Big Bold Sale Partner
        </a>
        <a href="/go/nykaa" class="partner-chip">
          <span class="dot-live">●</span> Nykaa Beauty & Cosmetics
        </a>
        <a href="/go/flipkart" class="partner-chip">
          <span class="dot-live">●</span> Flipkart Super Deals
        </a>
        <a href="/go/croma" class="partner-chip">
          <span class="dot-live">●</span> Croma Electronics
        </a>
        <a href="/go/myntra" class="partner-chip">
          <span class="dot-live">●</span> Myntra Lifestyle & Footwear
        </a>
        <a href="/go/tatacliq" class="partner-chip">
          <span class="dot-live">●</span> Tata CLiQ Luxury
        </a>
      </div>
      <!-- Duplicate content for seamless infinite marquee loop -->
      <div class="marquee-content" aria-hidden="true">
        <a href="/go/agoda" class="partner-chip">
          <span class="dot-live">●</span> Agoda Official Partner (CID 1970139)
        </a>
        <a href="/go/amazon" class="partner-chip">
          <span class="dot-live">●</span> Amazon Associates India (bhujonline-21)
        </a>
        <a href="/go/ajio" class="partner-chip">
          <span class="dot-live">●</span> AJIO Big Bold Sale Partner
        </a>
        <a href="/go/nykaa" class="partner-chip">
          <span class="dot-live">●</span> Nykaa Beauty & Cosmetics
        </a>
        <a href="/go/flipkart" class="partner-chip">
          <span class="dot-live">●</span> Flipkart Super Deals
        </a>
        <a href="/go/croma" class="partner-chip">
          <span class="dot-live">●</span> Croma Electronics
        </a>
        <a href="/go/myntra" class="partner-chip">
          <span class="dot-live">●</span> Myntra Lifestyle & Footwear
        </a>
        <a href="/go/tatacliq" class="partner-chip">
          <span class="dot-live">●</span> Tata CLiQ Luxury
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. IMMERSIVE VISUAL CATEGORY SHOWCASE (HIGH-RES PHOTOGRAPHIC CARDS)
       ========================================================================= -->
  <section class="section categories-photographic-section">
    <div class="container">
      <div class="section-header-modern">
        <div class="header-left">
          <span class="badge badge-brand">EXPLORE HUBS</span>
          <h2 class="section-title-modern">
            Browse Handpicked Shopping & Travel Hubs
          </h2>
          <p class="section-subtitle-modern">
            Every category curated with laboratory test data, verified coupons,
            and store price comparisons.
          </p>
        </div>
        <a href="/deals" class="btn btn-secondary btn-sm"
          >All Categories &rarr;</a
        >
      </div>

      <div class="category-photo-grid">
        {
          CATEGORIES.map((cat) => (
            <a href={`/${cat.slug}`} class="photo-cat-card card">
              <div class="photo-cat-media">
                <img
                  src={cat.heroImage}
                  alt={cat.name}
                  loading="lazy"
                  class="photo-cat-img"
                />
                <div class="photo-cat-overlay" />
              </div>

              <div class="photo-cat-content">
                <div class="photo-cat-top">
                  <span class="cat-icon-badge">{cat.icon}</span>
                  <span class="cat-deals-count">
                    {cat.itemCount.toLocaleString()}+ Deals
                  </span>
                </div>
                <h3 class="photo-cat-title">{cat.name}</h3>
                <p class="photo-cat-desc">{cat.shortDesc}</p>

                <div class="photo-cat-footer">
                  <div class="store-pills-row">
                    {cat.featuredStores.slice(0, 2).map((st) => (
                      <span class="photo-store-tag">{st}</span>
                    ))}
                  </div>
                  <span class="photo-cat-arrow">&rarr;</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. TODAY'S HOTTEST FLASH DEALS & PRICE DROPS (WITH COUNTDOWN)
       ========================================================================= -->
  <section class="section flash-deals-modern-section">
    <div class="container">
      <div class="section-header-modern">
        <div class="header-left">
          <div class="live-flash-badge">
            <span class="pulse-fire">🔥</span>
            <span>TODAY'S HIGHEST VALUE DEALS</span>
          </div>
          <h2 class="section-title-modern">
            Verified Flash Deals & Promo Codes
          </h2>
          <p class="section-subtitle-modern">
            Monitored hourly. Prices and coupon validity double-checked across
            certified stores.
          </p>
        </div>
        <a href="/deals" class="btn btn-secondary btn-sm"
          >All {DEALS.length} Active Deals &rarr;</a
        >
      </div>

      <div
        class="deal-countdown"
        id="flash-countdown"
        aria-label="Deal ends in"
      >
        <span class="countdown-unit"
          ><span id="cd-h">00</span><span class="cd-lbl">H</span></span
        >
        <span class="countdown-sep">:</span>
        <span class="countdown-unit"
          ><span id="cd-m">00</span><span class="cd-lbl">M</span></span
        >
        <span class="countdown-sep">:</span>
        <span class="countdown-unit"
          ><span id="cd-s">00</span><span class="cd-lbl">S</span></span
        >
        <span class="cd-suffix">until midnight IST reset</span>
      </div>

      <div class="grid-4">
        {flashDeals.map((deal) => <CouponCard deal={deal} />)}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       5. AGODA PARTNER SPOTLIGHT: KUTCH & HERITAGE PALACE GETAWAYS
       ========================================================================= -->
  <section class="section agoda-heritage-section">
    <div class="container">
      <div class="agoda-spotlight-card glass-panel">
        <div class="agoda-spotlight-header">
          <div>
            <div class="agoda-badge-row">
              <span class="agoda-official-badge"
                >🏨 AGODA OFFICIAL PARTNER (CID 1970139)</span
              >
              <span class="agoda-guarantee-badge">✓ Best Price Guarantee</span>
            </div>
            <h2 class="agoda-spotlight-title">
              Featured Royal Palaces & Kutch Escapes on Agoda
            </h2>
            <p class="agoda-spotlight-subtitle">
              Instant member tariffs with free cancellation across Bhuj,
              Dholavira UNESCO Site, Udaipur Lake Pichola, Jaipur, Jaisalmer &
              Srinagar.
            </p>
          </div>

          <div class="agoda-cities-pills">
            <a
              href="/go/agoda?city=bhuj"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="agoda-city-pill">📍 Bhuj</a
            >
            <a
              href="/go/agoda?city=dholavira"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="agoda-city-pill">🏛️ Dholavira</a
            >
            <a
              href="/go/agoda?city=udaipur"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="agoda-city-pill">🏰 Udaipur</a
            >
            <a
              href="/go/agoda?city=jaipur"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="agoda-city-pill">👑 Jaipur</a
            >
            <a
              href="/go/agoda?city=jaisalmer"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="agoda-city-pill">🏜️ Jaisalmer</a
            >
            <a
              href="/go/agoda?city=srinagar"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="agoda-city-pill">🏔️ Srinagar</a
            >
          </div>
        </div>

        <!-- Hotel Cards List -->
        <div class="hotels-modern-list">
          {topHotels.map((hotel) => <HotelCard hotel={hotel} />)}
        </div>

        <div class="agoda-footer-cta">
          <div class="cta-text">
            <strong>Traveling somewhere else?</strong> Search over 2,000,000 properties
            worldwide with exclusive Agoda VIP discounts.
          </div>
          <a
            href="/go/agoda"
            target="_blank"
            rel="sponsored nofollow noopener"
            class="btn btn-affiliate"
          >
            Search All Agoda Hotels &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       6. TOP TESTED PRODUCTS SHOWCASE (AMAZON, FLIPKART & CROMA)
       ========================================================================= -->
  <section class="section trending-products-section">
    <div class="container">
      <div class="section-header-modern">
        <div class="header-left">
          <span class="badge badge-brand">TESTED & RECOMMENDED</span>
          <h2 class="section-title-modern">
            Editor's Top Tested Tech & Beauty Essentials
          </h2>
          <p class="section-subtitle-modern">
            Products that achieved top marks in build quality, performance, and
            real-world value.
          </p>
        </div>
        <a href="/electronics" class="btn btn-secondary btn-sm"
          >More Electronics &rarr;</a
        >
      </div>

      <div class="grid-3">
        {
          trendingProds
            .slice(0, 3)
            .map((prod) => <ProductCard product={prod} />)
        }
      </div>
    </div>
  </section>

  <!-- =========================================================================
       7. FASHION RUNWAY & SNEAKER RADAR (AJIO & MYNTRA SPOTLIGHT)
       ========================================================================= -->
  <section class="section fashion-spotlight-modern">
    <div class="container">
      <div class="fashion-banner-box">
        <div class="fashion-banner-content">
          <span class="fashion-tag-badge">🛍️ AJIO & MYNTRA EXCLUSIVE DROPS</span
          >
          <h2 class="fashion-banner-title">
            50% to 90% Off on Top Streetwear, Kurtas & Sneakers
          </h2>
          <p class="fashion-banner-desc">
            Direct verified shortlinks for the AJIO Big Bold Sale & Myntra
            Lifestyle Collections. Premium combed cotton hoodies, royal wedding
            kurtas, and memory foam sneakers.
          </p>
          <div class="fashion-cta-row">
            <a
              href="/go/ajio"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="btn btn-affiliate"
            >
              Shop AJIO Sale &rarr;
            </a>
            <a
              href="/go/myntra"
              target="_blank"
              rel="sponsored nofollow noopener"
              class="btn btn-secondary"
            >
              Shop Myntra Trends &rarr;
            </a>
          </div>
        </div>
        <div class="fashion-banner-media">
          <img
            src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&w=700&q=80"
            alt="AJIO Streetwear Collection"
            class="fashion-feature-img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       8. MULTI-STORE TECH COMPARISON MATRIX
       ========================================================================= -->
  <section class="section comparison-highlight-section">
    <div class="container">
      <div class="section-header-modern">
        <div class="header-left">
          <span class="badge badge-brand">WIRECUTTER COMPARISON BENCHMARK</span>
          <h2 class="section-title-modern">
            Flagship Laptops & Smartphones Compared
          </h2>
          <p class="section-subtitle-modern">
            Side-by-side battery endurance, processor performance, and
            multi-store pricing.
          </p>
        </div>
