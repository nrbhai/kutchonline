═══════════════════════════════════════════════════════════════ -->
<style is:global>

/* ── Reset helpers ──────────────────────────────── */
.hp-hero *, .hp-main *, .hp-seo-cloud *, .hp-seo-text * { box-sizing: border-box; }

/* ═══════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════ */
.hp-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #060b18;
  padding: 0;
}

/* Gradient background orbs */
.hp-hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.hp-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  opacity: 0.55;
  animation: orbFloat 8s ease-in-out infinite alternate;
}
.hp-orb-1 {
  width: 700px; height: 700px;
  background: radial-gradient(circle, #1d4ed8 0%, transparent 70%);
  top: -200px; left: -150px;
  animation-delay: 0s;
}
.hp-orb-2 {
  width: 500px; height: 500px;
  background: radial-gradient(circle, #7c3aed 0%, transparent 70%);
  bottom: -150px; right: -100px;
  animation-delay: -3s;
}
.hp-orb-3 {
  width: 400px; height: 400px;
  background: radial-gradient(circle, #0891b2 0%, transparent 70%);
  top: 50%; left: 55%;
  transform: translate(-50%,-50%);
  animation-delay: -6s;
  opacity: 0.3;
}
