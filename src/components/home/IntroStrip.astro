---
// IntroStrip.astro
---

<div class="intro-bar">
  <div class="home-container">
    <div class="intro-grid">
      <div class="intro-card scroll-reveal">
        <div class="intro-card-icon">🏜️</div>
        <h3 class="intro-card-title">The Great Rann</h3>
        <p class="intro-card-text">World's largest salt desert, glowing white under the full moon.</p>
      </div>
      <div class="intro-card scroll-reveal">
        <div class="intro-card-icon">🦩</div>
        <h3 class="intro-card-title">Wildlife Wonders</h3>
        <p class="intro-card-text">Flamingos, Great Indian Bustards, and wild asses in their habitat.</p>
      </div>
      <div class="intro-card scroll-reveal">
        <div class="intro-card-icon">🎨</div>
        <h3 class="intro-card-title">Living Crafts</h3>
        <p class="intro-card-text">Ajrakh printing, Rogan art, Bandhani weaving — alive and thriving.</p>
      </div>
      <div class="intro-card scroll-reveal">
        <div class="intro-card-icon">🛕</div>
        <h3 class="intro-card-title">Sacred Heritage</h3>
        <p class="intro-card-text">Ancient temples, Sufi dargahs, Harappan ruins, and Sikh gurudwaras.</p>
      </div>
      <div class="intro-card scroll-reveal">
        <div class="intro-card-icon">🌊</div>
        <h3 class="intro-card-title">Hidden Shores</h3>
        <p class="intro-card-text">Untouched beaches on the Arabian Sea — no crowds, just silence.</p>
      </div>
    </div>
  </div>
</div>
