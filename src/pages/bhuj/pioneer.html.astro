---
// Standalone page for Pioneer Computer Services sample page
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pioneer Computer Services | Expert Data Recovery & IT Solutions</title>
    <meta name="description" content="Pioneer Computer Services in Bhuj provides professional data recovery, laptop repairs, and enterprise IT infrastructure solutions since 1993.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Orbitron:wght@400;500;600;700;800;900&family=Shrikhand&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/style.css">
    
    <style is:inline>
        :root {
            --primary: #10b981; /* Emerald */
            --primary-dark: #065f46;
            --accent: #34d399;
            --bg-dark: #06100d; /* Very deep green/black */
            --text-light: #f0fdf4;
            --text-dim: #94a3b8;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(16, 185, 129, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ── Navbar Override ── */
        .topbar {
            background: rgba(6, 16, 13, 0.8) !important;
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--glass-border);
        }
        .topbar-brand { 
            font-family: 'Shrikhand', cursive !important; 
            font-size: 1.6rem !important;
            letter-spacing: 0.02em !important;
        }
        .topbar-brand-accent { color: #fff !important; }
        .topbar-brand-rest { color: var(--primary) !important; }
        .nav-link { color: var(--text-dim) !important; }
        .nav-link:hover { color: var(--accent) !important; }

        /* ── Hero ── */
        .hero {
            position: relative;
            height: 60vh;
            min-height: 450px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 0 20px;
            margin-top: 60px;
            background-image: linear-gradient(rgba(6, 16, 13, 0.6), rgba(6, 16, 13, 0.9)), url('/assets/public/images/pioneer-hero-bg.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            border-radius: 0 0 50px 50px;
        }

        .hero-content {
            max-width: 900px;
            z-index: 10;
        }

        .hero-kicker {
            font-family: 'Orbitron', sans-serif;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 20px;
            display: block;
        }

        .hero h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(2.5rem, 8vw, 4.5rem);
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 30px;
            background: linear-gradient(135deg, #fff 0%, #d1fae5 50%, var(--primary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: clamp(1.1rem, 2vw, 1.3rem);
            color: var(--text-dim);
            max-width: 650px;
            margin: 0 auto 25px;
        }

        .hero-link-wrap {
            margin-top: 15px;
        }
        .hero-link {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            border-bottom: 1px solid transparent;
            padding-bottom: 2px;
        }
        .hero-link:hover {
            color: white;
            border-bottom-color: var(--accent);
            padding-left: 5px;
        }

        /* ── Stats ── */
        .stats {
            background: rgba(16, 185, 129, 0.05);
            padding: 80px 20px;
            border-top: 1px solid var(--glass-border);
            border-bottom: 1px solid var(--glass-border);
        }

        .stats-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 40px;
            text-align: center;
        }

        .stat-item h4 {
            font-family: 'Orbitron', sans-serif;
            font-size: 3rem;
            font-weight: 900;
            color: white;
            margin-bottom: 5px;
        }

        .stat-item p {
            color: var(--accent);
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 1px;
            font-size: 0.85rem;
        }

        /* ── Services ── */
        .services {
            padding: 100px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-head {
            text-align: center;
            margin-bottom: 70px;
        }

        .section-head h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.8rem;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .section-head p {
            color: var(--text-dim);
            font-size: 1.1rem;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 30px;
        }

        .service-card {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 0;
            display: flex;
            flex-direction: column;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .service-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary);
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        .service-img-wrap {
            width: 100%;
            height: 220px;
            overflow: hidden;
            border-radius: 24px 24px 0 0;
        }
        .service-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .service-card:hover .service-img-wrap img {
            transform: scale(1.1);
        }

        .service-content {
            padding: 25px 30px 35px;
        }

        .service-content h3 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: var(--accent);
        }

        .service-content p {
            color: var(--text-dim);
            font-size: 1.05rem;
        }

        /* ── Location ── */
        .location-section {
            padding: 80px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .map-container {
            border-radius: 30px;
            overflow: hidden;
            border: 1px solid var(--glass-border);
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        }

        /* ── CTA ── */
        .cta-section {
            padding: 120px 20px;
        }

        .cta-card {
            max-width: 1000px;
            margin: 0 auto;
            background: linear-gradient(135deg, var(--primary-dark) 0%, #06100d 100%);
            border-radius: 40px;
            padding: 80px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 30px 100px rgba(0,0,0,0.6);
        }

        .cta-card h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: 3rem;
            margin-bottom: 25px;
        }

        .cta-card p {
            color: #d1fae5;
            font-size: 1.2rem;
            margin-bottom: 50px;
        }

        .cta-grid {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
        }

        .cta-item {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 20px 30px;
            border-radius: 20px;
            text-decoration: none;
            color: white;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s ease;
        }

        .cta-item:hover {
            background: white;
            color: var(--primary-dark);
            transform: translateY(-5px);
        }

        /* ── Footer ── */
        footer {
            padding: 60px 20px;
            text-align: center;
            border-top: 1px solid var(--glass-border);
            background: #040d0a;
        }

        .footer-logo {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 20px;
            display: block;
            color: white;
            text-decoration: none;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .footer-links a {
            color: var(--text-dim);
            text-decoration: none;
            font-size: 0.9rem;
        }

        .footer-links a:hover {
            color: white;
        }

        .copy {
            color: #475569;
            font-size: 0.85rem;
        }

        @media (max-width: 768px) {
            .hero h1 { font-size: 2.8rem; }
            .cta-card { padding: 50px 20px; }
            .cta-card h2 { font-size: 2rem; }
            .stats-inner { gap: 20px; }
            .stat-item h4 { font-size: 2.2rem; }
        }
    </style>
</head>
