═══════════════════════════════════════════════════════════════ -->
<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

  /* ── FAQ accordion ───────────────────────────── */
  document.querySelectorAll('.hp-faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item   = btn.closest('.hp-faq-item');
      const body   = item.querySelector('.hp-faq-body');
      const isOpen = item.classList.contains('hp-open');

      document.querySelectorAll('.hp-faq-item').forEach(el => {
        el.classList.remove('hp-open');
        el.querySelector('.hp-faq-btn').setAttribute('aria-expanded', 'false');
        el.querySelector('.hp-faq-body').style.maxHeight = '';
      });

      if (!isOpen) {
        item.classList.add('hp-open');
        btn.setAttribute('aria-expanded', 'true');
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });

  /* ── Category tab filter ─────────────────────── */
  const tabMap = {
    home:    ['ac-fridge-repair','cctv-installation','dish-antenna-services','electrician','electronics-repairing','fire-safety','fire-services','modular-kitchen','pop-false-ceiling','plumber','ro-water-purifier','water-purifier-service','tank-cleaning','tiles-fitter','water-tanker-services','repairing-mixer-home-appliances','repairing-motor','repairing-washing-machine','pest-control','sanatary','tiles-sanitary','inverter-battery-dealers'],
    medical: ['ambulance','ayurvedic-doctors','blood-bank','dentist','doctors-mbbs','doctors-md-kidney-specialist','doctors-md-physician','homeopathy-doctors','hospitals','laboratory','medical-store','nurses','nutritionists-dieticians','physiotherapists','veterinary-doctor','yoga-fitness-trainers','naturopathy-center','psychology-counsellor'],
    pro:     ['accounting-services','advocate-lawyer','legal-services-lawyer','ca','career-counseling','civil-contractor','civil-engineers','coaching-classes','computer-classes','computer-laptop-sales','computer-sales-repair','data-recovery-services','digital-marketing','estate-agent','real-estate-agents','financial-advisor','graphic-designers','gst-accounting-services','jee-neet-coaching','journalist','motor-driving-school','car-driving-school','mutual-fund-advisors','notary','printer-repairs','printing-flex-banner','share-brokers-stock-market','software-developers','tax-consultant','teachers','ticket-booking-rail-air','tours-travels','upsc-gpsc-coaching','website-designers','rto-agent','insurance-agent','insurance-companies'],
    retail:  ['bakery','bike-car-rentals','bridal-wear','builders-developers','carpenter-furniture','caterers','cloths-merchant','cycle-store','decorators','driver','event-planners','flower-shops','foam-sofa-items','gift-shop','kirana-stores','laundry-dhobi','masons-kadia','mobile-repairing','mobile-shop','pg-hostels','photographers-videographers','riksha','schools','stationery','sweet-shop-mithai','tailor','taxi','tent-sound-system','transport-tempo-services','toy-store','hardware-stores','electric-stores','home-decoration-items','furniture-shops']
  };

  const catGrid    = document.getElementById('category-list');
  const searchIn   = document.getElementById('home-search');
  const tabs       = document.querySelectorAll('.hp-tab');

  function applyTab(key) {
    if (!catGrid) return;
    catGrid.querySelectorAll('.hp-cat-item').forEach(li => {
      if (key === 'all') { li.style.display = ''; return; }
      const href = li.querySelector('a')?.getAttribute('href') || '';
      const id   = href.split('/').pop().replace('-in-bhuj.html','');
      li.style.display = (tabMap[key] || []).includes(id) ? '' : 'none';
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => { t.classList.remove('hp-tab-active'); t.setAttribute('aria-selected','false'); });
      tab.classList.add('hp-tab-active');
      tab.setAttribute('aria-selected','true');
      applyTab(tab.dataset.tab);
      if (searchIn && searchIn.value) {
        searchIn.value = '';
        searchIn.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
  });

  /* Reset tab when typing */
  if (searchIn) {
    searchIn.addEventListener('input', () => {
      if (searchIn.value.trim()) {
        tabs.forEach(t => { t.classList.remove('hp-tab-active'); t.setAttribute('aria-selected','false'); });
        const allTab = document.querySelector('.hp-tab[data-tab="all"]');
        if (allTab) { allTab.classList.add('hp-tab-active'); allTab.setAttribute('aria-selected','true'); }
      }
    });
  }

  /* ── Quick chip clicks ───────────────────────── */
  document.querySelectorAll('.hp-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      if (!searchIn) return;
      searchIn.value = chip.dataset.query || chip.textContent.trim();
      searchIn.dispatchEvent(new Event('input', { bubbles: true }));
      searchIn.focus();
      const clearBtn = document.getElementById('clear-search-btn');
      if (clearBtn) clearBtn.style.display = 'flex';
    });
  });

});
</script>

<!-- ═══════════════════════════════════════════════════════════════
