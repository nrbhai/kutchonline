---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HotelCard from '../../components/HotelCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { HOTELS } from '../../data/hotels';

const partnerCities = [
  {
    name: "Bhuj, Kutch",
    tagline: "Heritage Bhunga Villas & White Desert Gateway",
    image: "https://images.unsplash.com/photo-1596178065887-1198b6148b2b?auto=format&fit=crop&w=600&q=80",
    cityId: "671731",
    score: "9.2 Superb",
    ratesFrom: "₹4,200",
    url: "/go/agoda?city=bhuj"
  },
  {
    name: "Dholavira, Rann",
    tagline: "UNESCO World Heritage & Harappan Oasis",
    image: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80",
    cityId: "728349",
    score: "9.1 Superb",
    ratesFrom: "₹4,500",
    url: "/go/agoda?city=dholavira"
  },
  {
    name: "Udaipur, Lake Pichola",
    tagline: "Royal Palaces, Mewar Suites & Sunset Boat Escapes",
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80",
    cityId: "3667",
    score: "9.8 Exceptional",
    ratesFrom: "₹18,500",
    url: "/go/agoda?city=udaipur"
  },
  {
    name: "Jaipur, Pink City",
    tagline: "Taj Rambagh, Maharajah Courtyards & Forts",
    image: "https://images.unsplash.com/photo-1477587458883-47145ed94245?auto=format&fit=crop&w=600&q=80",
    cityId: "8845",
    score: "9.7 Exceptional",
    ratesFrom: "₹16,000",
    url: "/go/agoda?city=jaipur"
  },
  {
    name: "Jaisalmer, Thar Desert",
    tagline: "Golden Sandstone Fortresses & Desert Dunes",
    image: "https://images.unsplash.com/photo-1518684079-3c830dcef090?auto=format&fit=crop&w=600&q=80",
    cityId: "7719",
    score: "9.4 Superb",
    ratesFrom: "₹12,800",
    url: "/go/agoda?city=jaisalmer"
  },
  {
    name: "Srinagar, Kashmir",
    tagline: "Dal Lake Heritage Chinar Mansions & Shikaras",
    image: "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=600&q=80",
    cityId: "10188",
    score: "9.5 Superb",
    ratesFrom: "₹14,500",
    url: "/go/agoda?city=srinagar"
  }
];

const hotelFaqs = [
  {
    question: "How do you find the lowest rates across Booking.com and Agoda?",
    answer: "Our automated price engine checks official Agoda Partner feeds (CID: 1970139) concurrently with Booking.com and MakeMyTrip, accounting for localized taxes, app-only promo codes, and loyalty VIP tier discounts."
  },
  {
    question: "Is free cancellation guaranteed on all listed Agoda properties?",
    answer: "Every card clearly flags whether the property includes free cancellation up to 24–48 hours before check-in. Always verify the cancellation cut-off date on the Agoda checkout page before completing payment."
  },
  {
    question: "Do you charge extra booking fees?",
    answer: "No. You pay the exact same or lower price directly on Agoda or the hotelier's official platform. We receive an official affiliate referral commission from Agoda at zero extra cost to you."
  }
];
---

<BaseLayout
  title="Best Hotel Deals 2026 | Agoda Partner Lowest Price Guarantee"
  description="Book top-rated hotels and luxury resorts in Bhuj, Dholavira, Udaipur, Jaipur, Jaisalmer and Srinagar. Verified lowest prices with Agoda CID 1970139."
>
  <!-- =========================================================================
       1. IMMERSIVE VISUAL DESTINATION HERO
       ========================================================================= -->
  <section class="hotels-hero-banner">
    <div class="hero-bg-media">
      <img 
        src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1920&q=85" 
        alt="Lake Pichola Udaipur Luxury Heritage Palace at Sunset" 
        class="hero-bg-img"
      />
      <div class="hero-gradient-overlay"></div>
    </div>

    <div class="container hero-content-wrap">
      <div class="breadcrumbs-dark">
        <Breadcrumbs crumbs={[{ label: "Hotels & Stays" }]} />
      </div>

      <div class="hero-badge-row">
        <span class="agoda-pill">
          <span class="radar-dot"></span>
          <span>AGODA OFFICIAL PARTNER ENGINE (CID 1970139)</span>
        </span>
        <span class="guarantee-pill">✓ Best Price & Free Cancellation Guarantee</span>
      </div>

      <h1 class="hero-title">
        Royal Palaces, Kutch Oases &<br />
        <span class="hero-highlight">Verified Lowest Hotel Tariffs</span>
      </h1>

      <p class="hero-desc">
        Direct Agoda member pricing across royal heritage retreats in Udaipur, Jaipur, and Kashmir, plus traditional Bhunga luxury villas in Bhuj and UNESCO Dholavira.
      </p>

      <!-- Instant Destination Search Box -->
      <div class="instant-search-glass glass-card-dark">
        <div class="search-input-field">
          <span class="search-ico">📍</span>
          <input 
            type="text" 
            id="dest-input" 
            placeholder="Search hotel name, city (Bhuj, Udaipur, Jaipur, Jaisalmer)..." 
            autocomplete="off"
          />
        </div>
        <a href="/go/agoda" target="_blank" rel="sponsored nofollow noopener" class="btn btn-affiliate search-btn">
          Search All 2M+ Agoda Hotels &rarr;
        </a>
      </div>
    </div>
  </section>

  <div class="container main-content-body">
    <!-- =========================================================================
         2. GRAPHICAL DESTINATION CARDS SHOWCASE (AGODA PARTNER HUBS)
         ========================================================================= -->
    <section class="destinations-section">
      <div class="section-heading-row">
        <div>
          <span class="badge badge-brand">OFFICIAL AGODA DESTINATION RADAR</span>
          <h2 class="section-title">Explore Verified Cities with Agoda Partner ID (1970139)</h2>
          <p class="section-subtitle">Instant member booking with free room upgrades, breakfast inclusions & zero booking fees.</p>
        </div>
        <a href="/go/agoda" target="_blank" rel="sponsored nofollow noopener" class="btn btn-secondary btn-sm">
          Browse All Cities on Agoda &rarr;
        </a>
      </div>

      <div class="destinations-grid">
        {partnerCities.map((c) => (
          <a href={c.url} target="_blank" rel="sponsored nofollow noopener" class="dest-card">
            <div class="dest-media">
              <img src={c.image} alt={c.name} loading="lazy" class="dest-img" />
              <div class="dest-overlay"></div>
              <span class="dest-score-badge">★ {c.score}</span>
              <span class="dest-agoda-chip">Agoda VIP</span>
            </div>
            <div class="dest-info">
              <h3 class="dest-name">{c.name}</h3>
              <p class="dest-tagline">{c.tagline}</p>
              <div class="dest-footer">
                <span class="dest-price-hint">From <strong>{c.ratesFrom}</strong>/night</span>
                <span class="dest-action">Check Agoda &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- =========================================================================
         3. FLIGHTS & AIRFARE DEALS BANNER
         ========================================================================= -->
    <div class="flight-banner-box">
      <div class="flight-content">
        <span class="flight-pill">✈️ AIRFARE SAVINGS RADAR</span>
        <h3 class="flight-title">Need Cheap Domestic or International Flights?</h3>
        <p class="flight-desc">
          Compare real-time airfares across IndiGo, Air India, Emirates, Vistara & SpiceJet. Zero convenience fee coupons and seasonal instant cashback.
        </p>
      </div>
      <a href="/go/flights" target="_blank" rel="sponsored nofollow noopener" class="btn btn-light flight-cta">
        Compare Flights &rarr;
      </a>
    </div>

    <!-- =========================================================================
         4. INTERACTIVE FILTER & VERIFIED HOTELS LIST
         ========================================================================= -->
    <section class="hotels-list-section">
      <div class="list-controls-bar">
        <div class="filter-pills-bar">
          <span class="filter-label">Filter Properties:</span>
          <button class="pill-btn active" data-filter="all">All Top Picks ({HOTELS.length})</button>
          <button class="pill-btn" data-filter="Luxury">Royal Palaces ({HOTELS.filter(h => h.tier === 'Luxury').length})</button>
          <button class="pill-btn" data-filter="Resort">Heritage & Eco Resorts ({HOTELS.filter(h => h.tier === 'Resort').length})</button>
        </div>
      </div>

      <div class="hotels-container" id="hotels-container">
        {HOTELS.map((hotel) => (
          <HotelCard hotel={hotel} />
        ))}
      </div>
    </section>

    <!-- =========================================================================
         5. AGODA PARTNER PERKS MATRIX
         ========================================================================= -->
    <div class="agoda-perks-box card">
      <div class="perks-header">
        <span class="badge badge-deal">WHY BOOK VIA BHUJDEALS & AGODA</span>
        <h3>The Agoda Advantage for India & Global Travel</h3>
      </div>
      <div class="perks-grid">
        <div class="perk-card">
          <span class="perk-icon">💎</span>
          <h4>Exclusive Wholesale Rates</h4>
          <p>Agoda secures direct contracts across India & Southeast Asia that undercut standard rack tariffs by 10%–25%.</p>
        </div>
        <div class="perk-card">
          <span class="perk-icon">🛡️</span>
          <h4>Guaranteed Free Cancellation</h4>
          <p>Lock in early bird room prices with the security of 24–48h free cancellation policies on all certified listings.</p>
        </div>
        <div class="perk-card">
          <span class="perk-icon">💳</span>
          <h4>Zero Hidden Convenience Fees</h4>
          <p>The tariff you see on Agoda includes transparent GST and service charges with no surprise checkout additions.</p>
        </div>
        <div class="perk-card">
          <span class="perk-icon">⚡</span>
          <h4>Instant Voucher Confirmation</h4>
          <p>Instant SMS & email voucher generation valid for expedited VIP check-in at all partner heritage resorts.</p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <FAQAccordion faqs={hotelFaqs} title="Agoda Booking & Hotel Rates FAQs" />
  </div>
</BaseLayout>

<script>
  // Interactive Destination & Filter
  const destInput = document.getElementById('dest-input') as HTMLInputElement;
  const pillBtns = document.querySelectorAll('.pill-btn');
  const hotelCards = document.querySelectorAll('.hotel-card');

  let activeTier = 'all';

  function filterHotels() {
    const q = (destInput?.value || '').toLowerCase().trim();

    hotelCards.forEach((card) => {
      const cardDest = (card.getAttribute('data-destination') || '').toLowerCase();
      const cardTitle = (card.querySelector('h3')?.textContent || '').toLowerCase();
      const cardTier = card.getAttribute('data-tier') || '';

      const matchesQuery = q === '' || cardDest.includes(q) || cardTitle.includes(q);
      const matchesTier = activeTier === 'all' || cardTier === activeTier;

      if (matchesQuery && matchesTier) {
        (card as HTMLElement).style.display = 'grid';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  if (destInput) destInput.addEventListener('input', filterHotels);

  pillBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      pillBtns.forEach(b => b.classList.remove('active'));
      const target = e.currentTarget as HTMLElement;
      target.classList.add('active');
      activeTier = target.getAttribute('data-filter') || 'all';
      filterHotels();
    });
  });
</script>

<style>
  /* =========================================================================
     1. HERO SECTION WITH IMMERSIVE BACKDROP
     ========================================================================= */
  .hotels-hero-banner {
    position: relative;
    padding: clamp(56px, 8vw, 84px) 0 64px;
    color: #ffffff;
    overflow: hidden;
    background: #0f172a;
  }

  .hero-bg-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7) contrast(1.1);
  }

  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(15, 23, 42, 0.7) 0%, rgba(15, 23, 42, 0.9) 80%, #0f172a 100%);
  }

  .hero-content-wrap {
    position: relative;
    z-index: 1;
    max-width: 960px;
  }

  .breadcrumbs-dark {
    margin-bottom: 20px;
  }

  .breadcrumbs-dark :global(a),
  .breadcrumbs-dark :global(span) {
    color: rgba(255, 255, 255, 0.75) !important;
  }

  .hero-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .agoda-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(2, 132, 199, 0.9);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.775rem;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    letter-spacing: 0.03em;
  }

  .guarantee-pill {
    display: inline-flex;
    align-items: center;
    background: rgba(34, 197, 94, 0.2);
    border: 1px solid rgba(34, 197, 94, 0.5);
    color: #4ade80;
    font-size: 0.775rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: var(--radius-full);
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .hero-highlight {
    background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 720px;
  }

  /* Glassmorphic Search */
  .instant-search-glass {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.4);
    max-width: 820px;
  }

  .search-input-field {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
  }

  .search-ico {
    font-size: 1.2rem;
  }

  #dest-input {
    width: 100%;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1rem;
    font-family: inherit;
    outline: none;
  }

  #dest-input::placeholder {
    color: rgba(255, 255, 255, 0.65);
  }

  .search-btn {
    white-space: nowrap;
    padding: 12px 24px;
    font-weight: 700;
  }

  /* Main Container */
  .main-content-body {
    padding-top: 48px;
    padding-bottom: 64px;
  }

  /* =========================================================================
     2. GRAPHICAL DESTINATIONS GRID
     ========================================================================= */
  .destinations-section {
    margin-bottom: 56px;
  }

  .section-heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .section-title {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 800;
    margin: 8px 0 6px;
    color: var(--text-main);
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 620px;
  }

  .destinations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .dest-card {
    border-radius: 16px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--border-default);
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.06);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }

  .dest-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 35px -10px rgba(2, 132, 199, 0.25);
    border-color: var(--color-primary);
  }

  .dest-media {
    position: relative;
    height: 180px;
    overflow: hidden;
  }

  .dest-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .dest-card:hover .dest-img {
    transform: scale(1.08);
  }

  .dest-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.6) 0%, transparent 60%);
  }

  .dest-score-badge {
    position: absolute;
    bottom: 10px;
    left: 10px;
    font-size: 0.725rem;
    font-weight: 800;
    background: rgba(255, 255, 255, 0.95);
    color: #0f172a;
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .dest-agoda-chip {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 0.7rem;
    font-weight: 700;
    background: #0284c7;
    color: #ffffff;
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .dest-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .dest-name {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 4px;
  }

  .dest-tagline {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin-bottom: 16px;
    flex: 1;
  }

  .dest-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--border-light);
  }

  .dest-price-hint {
    font-size: 0.8rem;
    color: var(--text-body);
  }

  .dest-price-hint strong {
    font-size: 0.95rem;
    color: var(--color-primary-dark);
  }

  .dest-action {
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  /* =========================================================================
     3. FLIGHTS BANNER
     ========================================================================= */
  .flight-banner-box {
    margin: 48px 0;
    padding: clamp(24px, 4vw, 36px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    border-radius: 20px;
    box-shadow: 0 15px 35px -10px rgba(2, 132, 199, 0.4);
    flex-wrap: wrap;
  }

  .flight-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    background: rgba(255, 255, 255, 0.2);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 10px;
  }

  .flight-title {
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    font-weight: 800;
    margin-bottom: 8px;
    color: #ffffff;
  }

  .flight-desc {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    max-width: 600px;
    line-height: 1.5;
  }

  .btn-light {
    background: #ffffff;
    color: #0284c7;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .btn-light:hover {
    background: #f0fdf4;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  /* =========================================================================
     4. HOTELS LIST & CONTROLS
     ========================================================================= */
  .hotels-list-section {
    margin-bottom: 56px;
  }

  .list-controls-bar {
    margin-bottom: 24px;
  }

  .filter-pills-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.825rem;
    font-weight: 800;
    color: var(--text-subtle);
  }

  .pill-btn {
    background: #ffffff;
    border: 1px solid var(--border-default);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.825rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    color: var(--text-body);
  }

  .pill-btn:hover {
    border-color: var(--color-primary);
  }

  .pill-btn.active {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }

  .hotels-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* =========================================================================
     5. AGODA PERKS MATRIX
     ========================================================================= */
  .agoda-perks-box {
    padding: clamp(28px, 4vw, 44px);
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid var(--border-default);
    margin-bottom: 48px;
  }

  .perks-header {
    margin-bottom: 28px;
  }

  .perks-header h3 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-top: 8px;
    color: var(--text-main);
  }

  .perks-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .perk-card {
    padding: 20px;
    background: #f8fafc;
    border-radius: 14px;
    border: 1px solid var(--border-light);
  }

  .perk-icon {
    font-size: 1.8rem;
    display: inline-block;
    margin-bottom: 12px;
  }

  .perk-card h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--text-main);
  }

  .perk-card p {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .destinations-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .perks-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .destinations-grid {
      grid-template-columns: 1fr;
    }

    .perks-grid {
      grid-template-columns: 1fr;
    }

    .instant-search-glass {
      flex-direction: column;
    }

    .search-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
