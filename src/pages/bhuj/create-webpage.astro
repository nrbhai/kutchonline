---
import BhujLayout from "../../layouts/BhujLayout.astro";
---

<BhujLayout
  title="Premium Business Webpage Creation Services in Bhuj | bhuj.kutchonline.com"
  description="Get a modern, mobile-friendly webpage for your business in Bhuj for only ₹699/year. Attract more customers, show service details, and get found online."
  canonicalPath="create-webpage"
>
  <main class="wrap" style="padding-top: 20px;">
      <div class="hero" style="text-align: center; margin-bottom: 44px;">
          <h1 style="font-family: var(--font-main); font-size: 1.25rem; font-weight: 700; color: #2563eb; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.1em;">Create Webpage</h1>
          <h2 style="font-family: var(--font-main); font-size: 2.5rem; font-weight: 900; background: linear-gradient(135deg, #2563eb 0%, #0f172a 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 20px; line-height: 1.1;">
              Get Your Business Online Today!
          </h2>
          <p style="font-size: 1.25rem; color: #475569; max-width: 750px; margin: 0 auto 30px;">Professional webpage for your business in Bhuj. Attract more customers and grow your business with a stunning online presence.</p>
      </div>

      <div class="pricing-card" style="background: #ffffff; background-image: radial-gradient(circle, #e2e8f0 1px, transparent 1px); background-size: 20px 20px; border-radius: 24px; padding: 50px; box-shadow: 0 14px 36px rgba(15, 23, 42, 0.05); text-align: center; margin-bottom: 44px; position: relative; overflow: hidden; border: 1px solid #e2e8f0;">
          <div class="pricing-glow" style="position: absolute; top: 0; left: 0; right: 0; height: 6px; background: linear-gradient(90deg, #2563eb 0%, #1d4ed8 100%);"></div>
          <div class="badge" style="display: inline-block; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; padding: 10px 24px; border-radius: 50px; font-weight: 800; font-size: 0.95rem; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1.5px;">🎉 Introductory Offer</div>
          <div class="original-price" style="text-decoration: line-through; color: #64748b; font-size: 1.6rem; margin-bottom: 10px; font-weight: 500;">Regular Price: ₹2,999</div>
          <div class="price" style="font-size: 5rem; font-weight: 900; color: #2563eb; margin: 20px 0; line-height: 1;"><span style="font-size: 3rem; color: #64748b; margin-right: 8px;">₹</span>699</div>
          <div class="duration" style="font-size: 1.3rem; color: #64748b; margin-bottom: 30px; font-weight: 500;">For 1 Full Year</div>
          <a href="tel:+919825034580" class="cta-button" style="display: inline-flex; align-items: center; gap: 12px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; padding: 20px 55px; border-radius: 14px; font-size: 1.3rem; font-weight: 800; text-decoration: none; box-shadow: 0 12px 30px rgba(37, 99, 235, 0.25); transition: all 0.3s ease; letter-spacing: 0.3px;">
              📞 Call Now: +91 98250 34580
          </a>
      </div>

      <div class="samples" style="background: #ffffff; background-image: radial-gradient(circle, #e2e8f0 1px, transparent 1px); background-size: 20px 20px; border-radius: 24px; padding: 50px; box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05); margin-bottom: 44px; border: 1px solid #e2e8f0;">
          <h2 style="font-size: clamp(1.9rem, 4vw, 2.45rem); font-weight: 800; color: #0f172a; margin-bottom: 15px; letter-spacing: -0.01em; text-align: center;">See What You'll Get</h2>
          <p style="font-size: 1.1rem; color: #64748b; text-align: center; margin-bottom: 40px;">Beautiful, professional webpages designed for local businesses</p>
          <div class="sample-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px;">
              <a href="/bhuj/haritech.html" class="sample-item" style="text-decoration: none; display: block; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 20px; box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04); transition: transform 0.3s ease;">
                  <div class="sample-placeholder" style="background: url('/assets/public/images/haritech-preview.webp'); background-size: cover; background-position: center; border: 1px solid #e2e8f0; border-radius: 12px; height: 300px; display: flex; align-items: center; justify-content: center; margin-bottom: 15px;">
                  </div>
                  <h3 style="font-size: 1.25rem; font-weight: 800; color: #2563eb; margin-bottom: 8px;">Hari Tech Solutions</h3>
                  <p style="font-size: 0.95rem; color: #475569; text-align: left;">Professional website design and software development services in Bhuj.</p>
              </a>
              <a href="/bhuj/pioneer.html" class="sample-item" style="text-decoration: none; display: block; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 20px; box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04); transition: transform 0.3s ease;">
                  <div class="sample-placeholder" style="background: url('/assets/public/images/pioneer-preview.webp'); background-size: cover; background-position: center; border: 1px solid #e2e8f0; border-radius: 12px; height: 300px; display: flex; align-items: center; justify-content: center; margin-bottom: 15px;">
                  </div>
                  <h3 style="font-size: 1.25rem; font-weight: 800; color: #2563eb; margin-bottom: 8px;">Pioneer Computer Services</h3>
                  <p style="font-size: 0.95rem; color: #475569; text-align: left;">Trusted IT solutions, computer sales, and repair services since 1993.</p>
              </a>
          </div>
      </div>

      <div class="features" style="background: #ffffff; background-image: radial-gradient(circle, #e2e8f0 1px, transparent 1px); background-size: 20px 20px; border-radius: 20px; padding: 45px; box-shadow: 0 10px 26px rgba(15, 23, 42, 0.05); margin-bottom: 36px; border: 1px solid #e2e8f0;">
          <h2 style="font-size: clamp(1.8rem, 3.6vw, 2.2rem); font-weight: 800; color: #0f172a; margin-bottom: 35px; letter-spacing: -0.01em; text-align: center;">What You Get</h2>
          <div class="feature-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px;">
              <div class="feature-item" style="display: flex; align-items: flex-start; gap: 15px;">
                  <div class="feature-icon" style="font-size: 2rem; flex-shrink: 0; color: #2563eb;">🌐</div>
                  <div class="feature-text">
                      <h3 style="font-size: 1.15rem; font-weight: 800; color: #2563eb; margin-bottom: 5px;">Professional Webpage</h3>
                      <p style="font-size: 0.95rem; color: #475569; line-height: 1.5;">Beautiful, mobile-friendly design tailored for your business</p>
                  </div>
              </div>
              <div class="feature-item" style="display: flex; align-items: flex-start; gap: 15px;">
                  <div class="feature-icon" style="font-size: 2rem; flex-shrink: 0; color: #2563eb;">📱</div>
                  <div class="feature-text">
                      <h3 style="font-size: 1.15rem; font-weight: 800; color: #2563eb; margin-bottom: 5px;">Mobile Responsive</h3>
                      <p style="font-size: 0.95rem; color: #475569; line-height: 1.5;">Looks perfect on all devices - phone, tablet, desktop</p>
                  </div>
              </div>
              <div class="feature-item" style="display: flex; align-items: flex-start; gap: 15px;">
                  <div class="feature-icon" style="font-size: 2rem; flex-shrink: 0; color: #2563eb;">⚡</div>
                  <div class="feature-text">
                      <h3 style="font-size: 1.15rem; font-weight: 800; color: #2563eb; margin-bottom: 5px;">Fast Loading</h3>
                      <p style="font-size: 0.95rem; color: #475569; line-height: 1.5;">Quick page loads for better customer experience</p>
                  </div>
              </div>
              <div class="feature-item" style="display: flex; align-items: flex-start; gap: 15px;">
                  <div class="feature-icon" style="font-size: 2rem; flex-shrink: 0; color: #2563eb;">🔗</div>
                  <div class="feature-text">
                      <h3 style="font-size: 1.15rem; font-weight: 800; color: #2563eb; margin-bottom: 5px;">Listed on bhuj.kutchonline.com</h3>
                      <p style="font-size: 0.95rem; color: #475569; line-height: 1.5;">Your webpage linked from our directory with active button</p>
                  </div>
              </div>
              <div class="feature-item" style="display: flex; align-items: flex-start; gap: 15px;">
                  <div class="feature-icon" style="font-size: 2rem; flex-shrink: 0; color: #2563eb;">📞</div>
                  <div class="feature-text">
                      <h3 style="font-size: 1.15rem; font-weight: 800; color: #2563eb; margin-bottom: 5px;">Contact Information</h3>
                      <p style="font-size: 0.95rem; color: #475569; line-height: 1.5;">Phone, WhatsApp, location - all included and clickable</p>
                  </div>
              </div>
              <div class="feature-item" style="display: flex; align-items: flex-start; gap: 15px;">
                  <div class="feature-icon" style="font-size: 2rem; flex-shrink: 0; color: #2563eb;">🎨</div>
                  <div class="feature-text">
                      <h3 style="font-size: 1.15rem; font-weight: 800; color: #2563eb; margin-bottom: 5px;">Custom Design</h3>
                      <p style="font-size: 0.95rem; color: #475569; line-height: 1.5;">Tailored to match your business style and brand</p>
                  </div>
              </div>
          </div>
      </div>

      <div class="contact" id="contact" style="text-align: center; background: #ffffff; background-image: radial-gradient(circle, #e2e8f0 1px, transparent 1px); background-size: 20px 20px; padding: 45px; border-radius: 18px; box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05); border: 1px solid #e2e8f0;">
          <h3 style="font-size: 1.6rem; font-weight: 800; margin-bottom: 15px; color: #0f172a;">Questions? We're Here to Help!</h3>
          <p style="font-size: 1.1rem; color: #475569; margin-bottom: 15px;">Contact Hari Tech Solutions</p>
          <p style="font-size: 1.1rem; color: #475569; margin-bottom: 8px;">📞 <a href="tel:+919825034580" style="color: #2563eb; font-weight: 700; text-decoration: none;">+91 98250 34580</a></p>
          <p style="font-size: 1.1rem; color: #475569;">💬 <a href="https://wa.me/919825034580" target="_blank" rel="noopener noreferrer" style="color: #2563eb; font-weight: 700; text-decoration: none;">WhatsApp Us</a></p>
      </div>
  </main>
</BhujLayout>
